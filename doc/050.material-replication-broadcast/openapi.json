{
  "openapi": "3.0.3",
  "info": {
    "title": "自动复刻批次飞书播报接口（待上线）",
    "version": "1.0.0-pending",
    "description": "状态：待上线，不代表生产可调用或真实飞书送达验收完成。上游每 2 小时汇总 replication_started、每 1 小时汇总 replication_failed，并负责跨批次只推新增；每次一个剪辑师、一种事件类型。接收方独立 outbox 可靠接收后尽快异步通知，不增加周期、不创建复刻、不轮询/写入素材业务表、不新增资源 20 分钟提醒。旧 /api/integrations/v1/material-task-status-events 保持不变，Token/重试隔离；同次失败不要同时调用新旧接口。"
  },
  "servers": [
    {
      "url": "https://ai.yingliangads.com",
      "description": "计划生产地址；当前状态：待上线"
    }
  ],
  "tags": [
    {
      "name": "MaterialReplication",
      "description": "已汇总复刻批次异步通知，非复刻任务执行接口"
    }
  ],
  "paths": {
    "/api/integrations/v1/material-replication-events": {
      "post": {
        "tags": [
          "MaterialReplication"
        ],
        "operationId": "acceptMaterialReplicationEvent",
        "summary": "可靠接收复刻汇总批次（待上线）",
        "description": "严格整批接收；同键同规范化内容返回原批次当前状态，JSON 对象键序无关，但 items/failed_languages 顺序有意义；同键改内容/顺序为 409。上游超时或 5xx 保持原键原内容按 1、5、30、120 秒重试；202 后不为补发而换键。收件人经 editor_username -> admin_users.username（大小写敏感精确匹配）-> admin_users.id -> admin_user_group.sub_user_id（status=0）-> email（复用既有用户名/邮箱映射缓存）-> 按邮箱查询飞书得到 open_id（首次发送前冻结）。空用户名、映射失败或明确私聊失败走既有兜底群。结果不确定时只在最多 3300 秒窗口内以同一冻结目标、正文和 UUID 尝试，最多 5 次；之后 delivery_unknown，不盲目换目标兜底。不承诺端到端严格 exactly-once。 最终消息大小预检仅对新批次执行；原键原内容重放读取原批次，不因未来模板变大拒绝或新增发送。",
        "security": [
          {
            "MaterialReplicationBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "首次发送前由上游持久化的业务批次唯一键；ASCII 8–128 字符，HTTP 重试必须复用原键与原内容。",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
            },
            "example": "mrb-start-editor-demo-20260827-1400-001"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "UTF-8 JSON，Content-Type application/json（可附 charset=utf-8）。顶层和每项禁止额外字段。原始体最多 32768 字节，最终飞书请求 JSON 含兜底包装和转义最多 131072 字节。 HTTP 客户端须提供唯一合法 Content-Length；不接受分块/压缩体、重复 JSON 对象字段或 NaN/Infinity。 128 KiB 是本接口较官方文本消息 150 KB 更保守的上限，3300 秒也较相同 UUID 的官方 1 小时窗口留有余量。",
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ReplicationStartedRequest"
                  },
                  {
                    "$ref": "#/components/schemas/ReplicationFailedRequest"
                  }
                ],
                "discriminator": {
                  "propertyName": "event_type",
                  "mapping": {
                    "replication_started": "#/components/schemas/ReplicationStartedRequest",
                    "replication_failed": "#/components/schemas/ReplicationFailedRequest"
                  }
                }
              },
              "examples": {
                "replication_started": {
                  "$ref": "#/components/examples/ReplicationStarted"
                },
                "replication_failed": {
                  "$ref": "#/components/examples/ReplicationFailed"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已可靠接收或同键同内容已存在。202 不等于送达；无必需 GET，可用原键原内容 POST 读取原批次当前状态。 同键同内容重放不重新渲染正文，不受未来模板扩大影响。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedResponse"
                },
                "examples": {
                  "accepted": {
                    "summary": "首次接收，尚未送达",
                    "value": {
                      "code": "accepted",
                      "message": "批次已接收，等待投递",
                      "batch_id": "MRB-0000000001",
                      "duplicate": false,
                      "item_count": 2,
                      "delivery_status": "queued",
                      "delivery_kind": "",
                      "received_at": "2026-08-27T06:00:00Z"
                    }
                  },
                  "duplicatePrivate": {
                    "summary": "重复提交，已确认私聊",
                    "value": {
                      "code": "duplicate_accepted",
                      "message": "批次已接收",
                      "batch_id": "MRB-0000000001",
                      "duplicate": true,
                      "item_count": 2,
                      "delivery_status": "delivered",
                      "delivery_kind": "private",
                      "received_at": "2026-08-27T06:00:00Z"
                    }
                  },
                  "duplicateFallback": {
                    "summary": "重复提交，仅确认兜底群",
                    "value": {
                      "code": "duplicate_accepted",
                      "message": "批次已接收",
                      "batch_id": "MRB-0000000001",
                      "duplicate": true,
                      "item_count": 2,
                      "delivery_status": "delivered",
                      "delivery_kind": "fallback",
                      "received_at": "2026-08-27T06:00:00Z"
                    }
                  },
                  "duplicateUnknown": {
                    "summary": "重复提交，结果未知，不重置投递",
                    "value": {
                      "code": "duplicate_accepted",
                      "message": "批次已接收",
                      "batch_id": "MRB-0000000001",
                      "duplicate": true,
                      "item_count": 2,
                      "delivery_status": "delivery_unknown",
                      "delivery_kind": "",
                      "received_at": "2026-08-27T06:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "HTTP 传输/Content-Length 不合法、分块/压缩体、体接收超时/中断，或非法 UTF-8 JSON/重复对象字段/非 JSON 数值，或缺少/非法幂等键；先修正请求。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                },
                "examples": {
                  "invalid_request": {
                    "value": {
                      "code": "invalid_request",
                      "message": "HTTP 请求不合法"
                    }
                  },
                  "invalid_json": {
                    "value": {
                      "code": "invalid_json",
                      "message": "JSON 无法解析"
                    }
                  },
                  "idempotency_key_required": {
                    "value": {
                      "code": "idempotency_key_required",
                      "message": "Idempotency-Key 必填"
                    }
                  },
                  "invalid_idempotency_key": {
                    "value": {
                      "code": "invalid_idempotency_key",
                      "message": "Idempotency-Key 格式不合法"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "本接口专属 Token 缺失或错误，不能使用旧接口 Token。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                },
                "examples": {
                  "invalid_token": {
                    "value": {
                      "code": "invalid_token",
                      "message": "Token 无效"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "相同键对应不同内容或数组顺序；核对原批次，不能换键掩盖未知结果。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdempotencyConflictError"
                },
                "examples": {
                  "idempotency_conflict": {
                    "value": {
                      "code": "idempotency_conflict",
                      "message": "相同幂等键对应不同请求内容"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "原始 UTF-8 请求体超过 32768 字节，或最终飞书请求 JSON（含兜底/页脚/转义）超过 131072 字节；整批拒绝，上游缩小并为各新子批次分配新键，不自动拆分。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayloadTooLargeError"
                },
                "examples": {
                  "payload_too_large": {
                    "value": {
                      "code": "payload_too_large",
                      "message": "请求体超过 32 KiB，请缩小批次"
                    }
                  },
                  "message_too_large": {
                    "value": {
                      "code": "message_too_large",
                      "message": "最终飞书请求超过 128 KiB，请缩小批次"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Content-Type 必须为 application/json，UTF-8 编码。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedMediaTypeError"
                },
                "examples": {
                  "unsupported_media_type": {
                    "value": {
                      "code": "unsupported_media_type",
                      "message": "Content-Type 必须为 application/json"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "字段、类型、数量、长度、单行或事件条件非法；整批拒绝，无部分接收。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidPayloadError"
                },
                "examples": {
                  "invalid_payload": {
                    "value": {
                      "code": "invalid_payload",
                      "message": "items[0].failed_languages 必须为非空数组"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "配置或可靠存储暂不可用；保留原键原内容按 1、5、30、120 秒退避重试。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUnavailableError"
                },
                "examples": {
                  "service_unavailable": {
                    "value": {
                      "code": "service_unavailable",
                      "message": "服务暂不可用"
                    }
                  }
                }
              }
            }
          }
        },
        "x-release-status": "待上线",
        "x-max-request-utf8-bytes": 32768,
        "x-max-feishu-request-utf8-bytes": 131072
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MaterialReplicationBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "本接口专属至少 32 个无空白 ASCII 字符的随机 Token",
        "description": "通过安全渠道单独提供，与旧接口分开。仅放 Authorization 请求头，不能放 URL、JSON、日志或公开代码。 Token 不含空白字符。"
      }
    },
