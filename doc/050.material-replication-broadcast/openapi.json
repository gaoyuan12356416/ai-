      "ReplicationStartedRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "editor_username",
          "items"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "replication_started"
            ]
          },
          "editor_username": {
            "$ref": "#/components/schemas/EditorUsername"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
