[Unit]
Description=Discover newly qualifying Meta cover replacements
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/data-disk/meta-violation-material-cleanup

[Service]
Type=oneshot
User=root
WorkingDirectory=/mnt/data-disk/meta-violation-material-cleanup/current/server-monitors/meta-violation-material-cleanup
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment=PYTHONUNBUFFERED=1
Environment=SQL_GATE_BYPASS=0
ExecStart=/usr/bin/env python3 cover.py --config /mnt/data-disk/meta-violation-material-cleanup/config.json scan
TimeoutStartSec=55min
KillSignal=SIGINT
TimeoutStopSec=180
UMask=0077
