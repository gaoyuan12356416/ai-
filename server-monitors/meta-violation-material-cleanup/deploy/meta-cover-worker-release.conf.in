# Pin a cover-enrichment fix without interrupting an active discovery scan.
[Service]
WorkingDirectory=@RELEASE@/server-monitors/meta-violation-material-cleanup
ExecStart=
ExecStart=/usr/bin/env python3 @RELEASE@/server-monitors/meta-violation-material-cleanup/cover.py --config /mnt/data-disk/meta-violation-material-cleanup/config.json work --max-ads 256
