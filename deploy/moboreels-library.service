[Unit]
Description=Moboreels library and KOC promotion service
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/data-disk

[Service]
Type=simple
WorkingDirectory=/opt/moboreels-library/current
EnvironmentFile=/etc/moboreels-library.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m features.moboreels_library.service
Restart=on-failure
RestartSec=5
UMask=0077
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
