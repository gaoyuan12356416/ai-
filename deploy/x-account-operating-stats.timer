[Unit]
Description=Refresh X account operating statistics at 10:00, 11:00, and 12:00 Beijing time

[Timer]
OnCalendar=*-*-* 10:00:00 Asia/Shanghai
OnCalendar=*-*-* 11:00:00 Asia/Shanghai
OnCalendar=*-*-* 12:00:00 Asia/Shanghai
Persistent=true
AccuracySec=1min
RandomizedDelaySec=0
Unit=x-account-operating-stats.service

[Install]
WantedBy=timers.target
