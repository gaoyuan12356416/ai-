# Copy to /etc/x-auto-post.secrets as root:x-post-daily mode 0440.
# Generate both values; never reuse any existing backend/daily/schedule bearer.
X_AUTO_POST_INTERNAL_TOKEN=replace-with-unique-admin-sidecar-token-at-least-32-characters

# Must exactly match X_POST_AUTO_INTERNAL_TOKEN in /etc/x-post-automation.env.
X_POST_AUTO_INTERNAL_TOKEN=replace-with-unique-x-auto-bridge-token-at-least-32-characters

# Copy only the existing read-only X MySQL connection values into this private
# file. Do not load /etc/x-post-daily.env into the auto sidecar because that
# would also expose the existing daily publisher bearer.
X_AUTO_POST_MYSQL_HOST=replace-with-read-only-host
X_AUTO_POST_MYSQL_PORT=replace-with-read-only-port
X_AUTO_POST_MYSQL_USER=replace-with-read-only-user
X_AUTO_POST_MYSQL_PASSWORD=replace-with-read-only-password
