# Copy to /etc/x-auto-post.secrets as root:x-post-daily mode 0440.
# Generate both values; never reuse any existing backend/daily/schedule bearer.
X_AUTO_POST_INTERNAL_TOKEN=replace-with-unique-admin-sidecar-token-at-least-32-characters

# Must exactly match X_POST_AUTO_INTERNAL_TOKEN in /etc/x-post-automation.env.
X_POST_AUTO_INTERNAL_TOKEN=replace-with-unique-x-auto-bridge-token-at-least-32-characters
