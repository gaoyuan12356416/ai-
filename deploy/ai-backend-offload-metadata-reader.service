[Unit]
Description=Named read-only drama and resource metadata queries
After=network-online.target ai-backend-offload-sql-tunnel.service

[Service]
User=ai-read-assist
Group=ai-read-assist
WorkingDirectory=/data/ai-backend-offload/metadata-current
EnvironmentFile=/etc/ai-backend-offload/sql-client.env
EnvironmentFile=/etc/ai-backend-offload/metadata-reader.env
ExecStart=/opt/pipeline-dispatch/venvs/68407465a58d99f9dd2c9a14da000f167115f804/bin/python -m features.gpu_offload.metadata_reader
Slice=ai-backend-offload-read.slice
CPUQuota=100%
MemoryLimit=256M
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
Restart=on-failure
RestartSec=10
SendSIGKILL=no
TimeoutStopSec=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
