[Unit]
Description=Daily Dramawave X post publisher
After=network-online.target x-post-automation.service
Wants=network-online.target
Requires=x-post-automation.service
RequiresMountsFor=/mnt/data-disk/x-post-automation
ConditionPathIsMountPoint=/mnt/data-disk

[Service]
Type=oneshot
User=x-post-daily
Group=x-post-daily
WorkingDirectory=/opt/x-post-automation/current
EnvironmentFile=/etc/x-post-daily.env
EnvironmentFile=/etc/x-post-media-repair.token
ExecStart=/usr/bin/python3 /opt/x-post-automation/current/scripts/x_post_daily_runner.py
RuntimeDirectory=x-post-daily
RuntimeDirectoryMode=0700
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
InaccessiblePaths=/var/lib/x-post-automation /etc/ssh
ReadOnlyPaths=/opt/x-post-automation/current /mnt/data-disk/x-post-automation/bin
ReadWritePaths=/run/x-post-daily /mnt/data-disk/x-post-automation/daily-work
UMask=0077
TimeoutStartSec=120min
