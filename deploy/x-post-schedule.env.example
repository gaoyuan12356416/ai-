# Copy to /etc/x-post-schedule.env with root ownership and mode 0400.
#
# The service also loads /etc/x-post-daily.env and deliberately reuses its
# dedicated daily internal bearer, read-only MySQL credentials, media host
# allowlist, data-disk work directory and GPU repair settings.  Do not place
# OAuth client secrets or X account tokens in this file.

# Set this to the first explicitly approved Beijing publishing date.
X_POST_SCHEDULE_START_DATE=2099-01-01

# Fixed safety contract: a missed point older than 90 seconds is ignored.
X_POST_SCHEDULE_GRACE_SECONDS=90
X_POST_SCHEDULE_MAX_DUE_BATCHES=10
# One deferred drama request may repair (up to 3600s) and then upload.
# Schedule-only override; the legacy daily runner default remains 900s.
X_POST_SCHEDULE_INTERNAL_TIMEOUT=7200
X_POST_SCHEDULE_DRAMA_APP_ID=1479
# A full schedule batch can contain 17 accounts.  Keep this schedule-specific
# override at or above that batch size so repairable media near the end of a
# batch is not rejected after the legacy daily repair budget is exhausted.
X_POST_SCHEDULE_MAX_REPAIRS_PER_RUN=17

X_POST_SCHEDULE_DUE_PATH=/internal/posts/schedules/due
X_POST_SCHEDULE_PLAN_QUERY_PATH=/internal/posts/schedule-plan/query
X_POST_SCHEDULE_PLAN_PATH=/internal/posts/schedule-plan
X_POST_SCHEDULE_FAILURE_PATH=/internal/posts/schedule-runs/record-failure
X_POST_SCHEDULE_MATERIAL_POOL_PATH=/internal/posts/material-pool/available
X_POST_SCHEDULE_MATERIAL_CHECK_PATH=/internal/posts/material-pool/check
X_POST_SCHEDULE_DRAMA_POOL_PATH=/internal/posts/drama-pool/available
X_POST_SCHEDULE_DRAMA_CHECK_PATH=/internal/posts/drama-pool/check
X_POST_SCHEDULE_STORAGE_PREFLIGHT_PATH=/internal/posts/storage/preflight
X_POST_SCHEDULE_PUBLISH_PATH_TEMPLATE=/internal/posts/queue/{queue_id}/publish

# The schedule and legacy daily/catch-up runners must share this lock.
X_POST_SCHEDULE_LOCK_PATH=/run/x-post-daily/runner.lock
X_POST_SCHEDULE_WORK_DIR=/mnt/data-disk/x-post-automation/daily-work
