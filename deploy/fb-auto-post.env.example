# CPU host /etc/fb-auto-post.env (root:root 0400; replace secrets locally)
FB_AUTO_POST_INTERNAL_TOKEN=replace-with-independent-random-secret
FB_AUTO_GPU_PREPARE_INTERNAL_TOKEN=replace-with-different-prepare-only-secret
FB_AUTO_POST_LIVE_ENABLED=0
FB_AUTO_POST_DB_PATH=/mnt/data-disk/fb-auto-post-publisher/fb-auto-post.sqlite3
FB_AUTO_METRIC_DB_PATH=/mnt/data-disk/fb-auto-post-publisher/fb-auto-metric.sqlite3
FB_AUTO_MYSQL_HOST=127.0.0.1
FB_AUTO_MYSQL_PORT=63350
FB_AUTO_MYSQL_USER=
FB_AUTO_MYSQL_PASSWORD=
FB_AUTO_MYSQL_DATABASE=kunlunads_dev
FB_AUTO_BLACKLIST_MYSQL_DATABASE=ads_setting
FB_AUTO_PREPARE_AHEAD_SECONDS=14400
FB_AUTO_MAX_PUBLISHABLE_PAGES=500
FB_AUTO_MAX_DAILY_JOBS=500
FB_AUTO_MAX_JOBS_PER_SLOT=20
FB_AUTO_MAX_ENABLED_TEMPLATES=10
FB_AUTO_GPU_PREPARE_PORT=18836
FB_AUTO_GPU_PREPARE_TIMEOUT=9000
FB_AUTO_METRIC_LOCK_PATH=/run/fb-auto-post/metric.lock
FB_GRAPH_API_VERSION=v22.0
