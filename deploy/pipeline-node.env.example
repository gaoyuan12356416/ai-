# This example contains no live secret. Node credentials are created with --enroll.
PIPELINE_NODE_ID=replace-with-unique-host-id
PIPELINE_NODE_CONFIG=/etc/pipeline-node.credentials.json
PIPELINE_NODE_STATE_ROOT=/mnt/data-disk/pipeline-dispatch/node
PIPELINE_COORDINATOR_URL=http://127.0.0.1:18846
PIPELINE_RENDER_BACKEND=cpu
PIPELINE_PREPARE_MAX=4
PIPELINE_PUBLISH_MAX=4
# Advertise only locally verified executors and immutable asset catalogs.
PIPELINE_EXECUTORS=x_publish,fb_publish,tt_publish,youtube_publish
# Comma-separated exact immutable render profiles verified on this host.
PIPELINE_RENDER_PROFILES=
# With tt_prepare enabled, list every locally verified TT profile. Rendering
# follows each task's frozen profile; TT_POST_GPU_MEDIA_MODE remains the default.
# CPU TT profiles (libx264 except source passthrough):
# tt-post-h264-720x1280-v2,tt-post-direct-clean-h264-720x1280-v1,tt-post-direct-outro-h264-720x1280-v2,tt-post-source-direct-v1,tt-post-random-overlay-libx264-720x1280-v1
# GPU TT profiles (HEVC/H264 NVENC except source passthrough):
# tt-post-hevc-720x1280-v2,tt-post-h264-720x1280-v2,tt-post-direct-clean-hevc-720x1280-v1,tt-post-direct-clean-h264-720x1280-v1,tt-post-direct-outro-hevc-720x1280-v2,tt-post-direct-outro-h264-720x1280-v2,tt-post-source-direct-v1,tt-post-random-overlay-hevc-720x1280-v3,tt-post-random-overlay-h264-720x1280-v3
# Branded-preview profiles remain ineligible for formal Direct Post. Advertising
# preparation does not open the original publication gates.
# Direct-outro assets retain TT_POST_GPU_FIXED_OUTRO_PATH/SHA256 and FONT_FILE.
# Node capabilities include their verified hashes; authority approval is separate.
# Existing-node targeted check, without COS/platform writes:
# python scripts/pipeline_node_check.py --env /private/node.env --encode --encode-profile tt-post-direct-outro-h264-720x1280-v2
PIPELINE_MEDIA_ALLOWED_HOSTS=
PIPELINE_FFMPEG_BIN=/usr/local/bin/ffmpeg
PIPELINE_FFPROBE_BIN=/usr/local/bin/ffprobe
# CPU preparation uses explicit new profiles; historical GPU jobs keep their profile.
# FB_PAGE_GPU_VIDEO_ENCODER=libx264
# FB_PAGE_GPU_PROFILE=fb-post-random-overlay-libx264-720x1280-v1
# FB_PAGE_GPU_COMPOSITOR_BACKEND=cpu_legacy
# Per-channel non-secret config and COS credentials must be loaded by the node's service.
