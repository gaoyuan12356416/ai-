# Copy to /etc/tt-post.env with root:root ownership and mode 0400.
# This file contains non-secret fixed safety settings only.

TT_POST_SERVICE_HOST=127.0.0.1
TT_POST_SERVICE_PORT=18829
TT_POST_INTERNAL_URL=http://127.0.0.1:18829
TT_POST_GPU_URL=http://127.0.0.1:18830
TT_POST_DB_PATH=/mnt/data-disk/tt-post-publisher/tt-post.sqlite3
TT_POST_SHORT_LINK_ROOT=/mnt/data-disk/tt-post-publisher/s2l

# Fixed read-only replica and schemas. The service rejects another port/host
# for the account snapshot source.
TT_POST_MYSQL_HOST=101.32.56.53
TT_POST_MYSQL_PORT=63350
TT_POST_ACCOUNT_MYSQL_DATABASE=ads_ai
TT_POST_MATERIAL_MYSQL_DATABASE=kunlunads_dev

# The confirmed source material contains a legacy CTA in the final 4.333333s.
# Set to 0 only after a source family is explicitly verified to need no trim.
TT_POST_DEFAULT_SOURCE_TRIM_TAIL_SECONDS=4.333333
TT_POST_MEDIA_PROFILE_VERSION=tt-post-hevc-720x1280-v2
# For an independently reviewed source with no CTA/watermark, pair GPU
# TT_POST_GPU_MEDIA_MODE=direct_clean with:
# TT_POST_DEFAULT_SOURCE_TRIM_TAIL_SECONDS=0
# TT_POST_MEDIA_PROFILE_VERSION=tt-post-direct-clean-hevc-720x1280-v1
# For reviewed formal posts that must append the fixed TT tutorial outro, pair
# GPU TT_POST_GPU_MEDIA_MODE=direct_outro with:
# TT_POST_DEFAULT_SOURCE_TRIM_TAIL_SECONDS=0
# TT_POST_MEDIA_PROFILE_VERSION=tt-post-direct-outro-hevc-720x1280-v1

# All three production gates intentionally default off. A due hold task becomes
# blocked_compliance and cannot reach TikTok Direct Post init.
TT_POST_LIVE_ENABLED=0
TT_POST_DIRECT_AUDIT_APPROVED=0
TT_POST_URL_PROPERTY_VERIFIED=0

# Fixed runner safety contract.
TT_POST_RUNNER_ID=tt-post-runner-primary
TT_POST_GRACE_SECONDS=600
TT_POST_CLAIM_LIMIT=1
TT_POST_RECONCILE_LIMIT=1
TT_POST_INTERNAL_TIMEOUT=60
TT_POST_SCHEDULE_TIMEOUT=1500
TT_POST_PUBLISH_TIMEOUT=2400
TT_POST_RECONCILE_TIMEOUT=1500
TT_POST_GPU_TIMEOUT=900
TT_POST_GPU_PREPARE_TIMEOUT=9000
TT_POST_RUNNER_LOCK_PATH=/run/tt-post/runner.lock
TT_POST_RUNNER_KICK_PATH=/run/tt-post/manual-kick

# Background media preparation is isolated from the due-publish runner.
# One invocation claims at most one item and renews its durable CPU lease while
# the GPU prepare request is active. The process timeout must stay at least 60s
# above TT_POST_GPU_PREPARE_TIMEOUT, and the systemd unit timeout must exceed
# both values.
TT_POST_PREPARE_RUNNER_ID=tt-post-prepare-primary
TT_POST_PREPARE_LEASE_SECONDS=180
TT_POST_PREPARE_RENEW_INTERVAL_SECONDS=30
TT_POST_PREPARE_INTERNAL_TIMEOUT=60
TT_POST_PREPARE_PROCESS_TIMEOUT=9300
TT_POST_PREPARE_RUNNER_LOCK_PATH=/run/tt-post/prepare-runner.lock
TT_POST_PREPARE_RUNNER_KICK_PATH=/run/tt-post/prepare-kick
