[Unit]
Description=Drama Synthesis HK GPU Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drama-synthesis-gpu
Group=drama-synthesis-gpu
WorkingDirectory=/data/drama-synthesis-gpu/current
EnvironmentFile=/etc/drama-synthesis-gpu/worker.env
Environment=DRAMA_GPU_HOST=127.0.0.1
Environment=DRAMA_GPU_PORT=8787
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
ExecStartPre=/data/drama-synthesis-gpu/runtime/current/bin/python /data/drama-synthesis-gpu/current/scripts/check_drama_synthesis_gpu_runtime.py --check-app-import
ExecStart=/data/drama-synthesis-gpu/runtime/current/bin/python /data/drama-synthesis-gpu/current/scripts/drama_synthesis_gpu_worker.py
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=14400
UMask=0077
Nice=0
CPUQuota=800%
TasksMax=512
IOSchedulingClass=best-effort
IOSchedulingPriority=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/data/drama-synthesis-gpu/assets /data/drama-synthesis-gpu/models /data/drama-synthesis-gpu/runtime /data/drama-synthesis-gpu/python
ReadWritePaths=/data/drama-synthesis-gpu/work /data/drama-synthesis-gpu/results

[Install]
WantedBy=multi-user.target
