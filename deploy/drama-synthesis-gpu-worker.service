[Unit]
Description=Drama Synthesis HK GPU Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drama-synthesis-gpu
Group=drama-synthesis-gpu
WorkingDirectory=/data/drama-synthesis-gpu/current
EnvironmentFile=/etc/drama-synthesis-gpu/worker.env
Environment=DRAMA_GPU_HOST=127.0.0.1
Environment=DRAMA_GPU_PORT=8787
ExecStart=/usr/bin/python3.9 /data/drama-synthesis-gpu/current/scripts/drama_synthesis_gpu_worker.py
Restart=always
RestartSec=5
TimeoutStopSec=14400
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/data/drama-synthesis-gpu/assets
ReadWritePaths=/data/drama-synthesis-gpu/work /data/drama-synthesis-gpu/results

[Install]
WantedBy=multi-user.target
