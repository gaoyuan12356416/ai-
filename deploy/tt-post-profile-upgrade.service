[Unit]
Description=Upgrade available TikTok Post materials to the Logo-free profile
After=network-online.target tt-post-service.service
Wants=network-online.target
Requires=tt-post-service.service
ConditionPathIsMountPoint=/mnt/data-disk

[Service]
Type=oneshot
User=tt-post
Group=tt-post
WorkingDirectory=/opt/tt-post/current
EnvironmentFile=/etc/tt-post.env
EnvironmentFile=/etc/tt-post.secrets
ExecStart=/usr/bin/python3 /opt/tt-post/current/scripts/upgrade_tt_post_recurring_profile.py --from-profile tt-post-direct-outro-hevc-720x1280-v1 --to-profile tt-post-direct-outro-hevc-720x1280-v2 --source-trim-tail-seconds 0 --limit 500 --apply
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
ReadOnlyPaths=/opt/tt-post/current
ReadWritePaths=/mnt/data-disk/tt-post-publisher /run/tt-post
UMask=0077
TimeoutStartSec=86400s
KillMode=mixed
