[Unit]
Description=Social media preparation and publication coordinator
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/data-disk

[Service]
Type=simple
WorkingDirectory=/opt/pipeline-dispatch/current
EnvironmentFile=/etc/pipeline-coordinator.env
ExecStart=/opt/pipeline-dispatch/coordinator-venv/bin/python -m features.pipeline_dispatch.service --config /etc/pipeline-coordinator.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# The authority needs read access to each existing channel ledger. It writes
# its own dispatch database; native ledgers are opened with mode=ro/query_only.
# SQLite 3.26 must create WAL shared-memory files even for read-only readers.
ProtectSystem=strict
ReadWritePaths=/mnt/data-disk/pipeline-dispatch
ReadWritePaths=/var/lib/x-post-automation /mnt/data-disk/x-auto-post-publisher /mnt/data-disk/x-post-automation/youtube-shares
ReadWritePaths=/mnt/data-disk/fb-auto-post-publisher /mnt/data-disk/tt-post-publisher /mnt/data-disk/tt-auto-post-publisher /root/drama_material_service/data
# The deployed app's /root path is a symlink; adapters resolve SQLite URIs.
ReadWritePaths=-/mnt/data-disk/root-storage-20260915/rootfs/root/drama_material_service/data

[Install]
WantedBy=multi-user.target
