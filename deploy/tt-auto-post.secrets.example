# Copy to /etc/tt-auto-post.secrets as root:tt-post mode 0440.
# Generate a new value; never reuse TT_POST_INTERNAL_TOKEN or the GPU token.
TT_AUTO_POST_INTERNAL_TOKEN=replace-with-unique-random-token-at-least-32-characters

# TT_POST_MYSQL_USER, TT_POST_MYSQL_PASSWORD, TT_POST_GPU_INTERNAL_TOKEN and
# TT_POST_GPU_CREDENTIAL_SEAL_KEY_B64 are read from the existing
# /etc/tt-post.secrets by the service unit and are not duplicated here.
