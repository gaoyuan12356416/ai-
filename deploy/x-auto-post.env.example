# Copy to /etc/x-auto-post.env as root:root mode 0444.
# Non-secret settings only. All three real-publish gates default closed.

X_AUTO_POST_SERVICE_HOST=127.0.0.1
X_AUTO_POST_SERVICE_PORT=18833
X_AUTO_POST_INTERNAL_URL=http://127.0.0.1:18833
X_AUTO_POST_ADMIN_SERVICE_URL=http://127.0.0.1:18833
X_AUTO_POST_DB_PATH=/mnt/data-disk/x-auto-post-publisher/x-auto-post.sqlite3
X_AUTO_POST_STATE_ROOT=/mnt/data-disk/x-auto-post-publisher
X_POST_AUTOMATION_INTERNAL_URL=http://127.0.0.1:8810

# Independent gates. Existing X schedule/daily settings cannot open them.
X_AUTO_POST_LIVE_ENABLED=0
X_AUTO_POST_ACCOUNT_AUDIT_APPROVED=0
X_AUTO_POST_URL_PROPERTY_VERIFIED=0

# Final publish serialization deliberately shares the existing X runner lock.
X_AUTO_POST_RUNNER_LOCK_PATH=/run/x-post-daily/runner.lock
X_AUTO_POST_SCHEDULER_LOCK_PATH=/run/x-auto-post/scheduler.lock
X_AUTO_POST_RUNNER_ID=x-auto-post-runner-primary
X_AUTO_POST_WORKER_COUNT=1
X_AUTO_POST_MAX_TASKS_PER_WORKER=1
X_AUTO_POST_LEASE_SECONDS=10800
X_AUTO_POST_SCHEDULE_GRACE_SECONDS=600
X_AUTO_POST_METRIC_LOCK_PATH=/run/x-auto-post/metric.lock
X_AUTO_POST_INTERNAL_TIMEOUT=120
X_AUTO_POST_EXECUTE_TIMEOUT=10200
# Ordinary bridge reads remain bounded. The publish call budget covers the
# existing X chunk-upload and media-processing loops and remains below the
# 10800-second task lease. Transport uncertainty is reconciled, never retried.
X_AUTO_POST_X_BRIDGE_TIMEOUT=120
X_AUTO_POST_X_PUBLISH_TIMEOUT=9000

# The service reads current MySQL/media/repair defaults from
# /etc/x-post-schedule.env. These X_AUTO_POST_* values may override them.
X_AUTO_POST_MYSQL_DATABASE=kunlunads_dev
X_AUTO_POST_BLACKLIST_DATABASE=ads_setting
X_AUTO_POST_MYSQL_CONNECT_TIMEOUT=5
X_AUTO_POST_MYSQL_READ_TIMEOUT=120
X_AUTO_POST_WORK_DIR=/mnt/data-disk/x-post-automation/daily-work
X_AUTO_POST_MAX_MEDIA_BYTES=536870912
X_AUTO_POST_MEDIA_TIMEOUT=30
X_AUTO_POST_MAX_REPAIRS_PER_RUN=1
X_AUTO_POST_REPAIR_TIMEOUT=900
X_AUTO_POST_METRIC_PLATFORM=0
X_AUTO_POST_METRIC_LOOKBACK_DAYS=7
X_AUTO_POST_PRODUCT=Dramawave
