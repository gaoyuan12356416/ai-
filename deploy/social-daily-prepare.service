[Unit]
Description=Prepare complete social publisher daily report data
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/data-disk

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/youtube-publisher-daily-report/current
ExecStart=/usr/bin/python3 /opt/youtube-publisher-daily-report/current/scripts/youtube_publisher_daily_report.py --publication-timezone UTC --prepare
TimeoutStartSec=180
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/data-disk/youtube-publisher-daily-report
ReadWritePaths=-/root/drama_material_service/data /var/lib/x-post-automation
ReadWritePaths=/mnt/data-disk/fb-auto-post-publisher /mnt/data-disk/social-analytics /mnt/data-disk/x-tag-publisher
ReadOnlyPaths=/root/drama_material_service/data/drama_material_jobs.sqlite3
ReadOnlyPaths=/var/lib/x-post-automation/accounts.sqlite3
ReadOnlyPaths=/mnt/data-disk/fb-auto-post-publisher/fb-auto-post.sqlite3
ReadOnlyPaths=-/mnt/data-disk/social-analytics/attribution.sqlite3
ReadOnlyPaths=/mnt/data-disk/x-tag-publisher/posts.sqlite3
