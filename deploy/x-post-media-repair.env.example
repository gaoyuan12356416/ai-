# Disabled until the dedicated bearer, source allowlist, and COS access are configured.
X_POST_MEDIA_REPAIR_ENABLED=0
X_POST_MEDIA_REPAIR_HOST=127.0.0.1
X_POST_MEDIA_REPAIR_PORT=8820
X_POST_MEDIA_REPAIR_ALLOWED_HOSTS=
X_POST_MEDIA_REPAIR_WORK_ROOT=/data/x-post-media-repair
X_POST_MEDIA_REPAIR_FFMPEG_BIN=/opt/ffmpeg-nvenc/ffmpeg
X_POST_MEDIA_REPAIR_FFPROBE_BIN=/opt/ffmpeg-nvenc/ffprobe
X_POST_MEDIA_REPAIR_COS_PREFIX=x-post-media-repair
X_POST_MEDIA_REPAIR_MAX_SOURCE_BYTES=536870912
X_POST_MEDIA_REPAIR_MAX_OUTPUT_BYTES=536870912
X_POST_MEDIA_REPAIR_DOWNLOAD_TIMEOUT=120
X_POST_MEDIA_REPAIR_PROBE_TIMEOUT=120
X_POST_MEDIA_REPAIR_TRANSCODE_TIMEOUT=1800
X_POST_MEDIA_REPAIR_COS_MAX_THREADS=4

# X_POST_MEDIA_REPAIR_TOKEN is stored separately in
# /etc/x-post-media-repair.token (root:root, mode 0400).
# COS_* values are loaded from the shared root-only service environment.
