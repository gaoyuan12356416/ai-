# GPU host /etc/fb-page-random-overlay-gpu.env (root:root 0400)
FB_PAGE_GPU_HOST=127.0.0.1
FB_PAGE_GPU_PORT=8836
FB_PAGE_GPU_INTERNAL_TOKEN=replace-with-the-same-prepare-only-secret-used-by-cpu
FB_PAGE_GPU_WORK_ROOT=/data/fb-page-random-overlay
FB_PAGE_GPU_PROFILE=tt-post-random-overlay-h264-720x1280-v3
FB_PAGE_GPU_VIDEO_ENCODER=h264_nvenc
FB_PAGE_GPU_OUTPUT_WIDTH=720
FB_PAGE_GPU_OUTPUT_HEIGHT=1280
FB_PAGE_GPU_PREPARE_ONLY=1
FB_PAGE_GPU_ALLOWED_SOURCE_HOSTS=cdn.example.com
FB_PAGE_GPU_COS_SECRET_ID=
FB_PAGE_GPU_COS_SECRET_KEY=
FB_PAGE_GPU_COS_BUCKET=
FB_PAGE_GPU_COS_REGION=
FB_PAGE_GPU_COS_DOMAIN=https://replace-with-verified-cos-domain.example
FB_PAGE_GPU_COS_PREFIX=fb-page-random-overlay-h264-v3
FB_PAGE_GPU_COS_TIMEOUT=120
FB_PAGE_GPU_RANDOM_OVERLAY_ROOT=/data/fb-page-random-overlay/assets/v1
FB_PAGE_GPU_RANDOM_OVERLAY_MANIFEST_SHA256=
FB_PAGE_GPU_FFMPEG_BIN=/usr/bin/ffmpeg
FB_PAGE_GPU_FFPROBE_BIN=/usr/bin/ffprobe
FB_PAGE_GPU_PREPARE_TIMEOUT=9000
FB_PAGE_GPU_FAILED_JOB_RETENTION_SECONDS=172800
FB_PAGE_GPU_CLEANUP_MAX_JOBS=100
