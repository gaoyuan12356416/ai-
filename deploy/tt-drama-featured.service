[Unit]
Description=Refresh the public TT featured-drama last-known-good cache
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/data-disk
ConditionPathIsMountPoint=/mnt/data-disk

[Service]
Type=oneshot
User=tt-drama-featured
Group=tt-drama-featured
WorkingDirectory=/mnt/data-disk/tt-drama-featured/current
EnvironmentFile=/etc/tt-drama-featured.env
Environment=TT_DRAMA_FEATURED_CACHE_PATH=/mnt/data-disk/tt-drama-featured/public/current.json
Environment=TT_DRAMA_FEATURED_LOCK_PATH=/run/tt-drama-featured/refresh.lock
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /mnt/data-disk/tt-drama-featured/current/scripts/refresh_tt_drama_featured.py
RuntimeDirectory=tt-drama-featured
RuntimeDirectoryMode=0700
UMask=0027
TimeoutStartSec=90s
Nice=10
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
ReadOnlyPaths=/mnt/data-disk/tt-drama-featured/current
ReadWritePaths=/mnt/data-disk/tt-drama-featured/public /run/tt-drama-featured
InaccessiblePaths=/root/.ssh
