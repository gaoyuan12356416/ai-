[Unit]
Description=AI backend immutable snapshot reports
After=network.target

[Service]
Type=simple
User=pipeline-worker
Group=pipeline-worker
WorkingDirectory=/data/ai-backend-offload/read-current
EnvironmentFile=/etc/ai-backend-offload/reader.env
ExecStart=/opt/pipeline-dispatch/venvs/68407465a58d99f9dd2c9a14da000f167115f804/bin/python -m features.gpu_offload.reader
Restart=on-failure
RestartSec=15
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Slice=ai-backend-offload-read.slice
CPUQuota=200%
CPUShares=128
MemoryLimit=4G
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
