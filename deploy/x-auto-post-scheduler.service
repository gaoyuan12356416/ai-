[Unit]
Description=Create due Dramawave X automatic publishing runs
After=network-online.target x-auto-post-service.service systemd-tmpfiles-setup.service
Requires=x-auto-post-service.service
ConditionPathIsDirectory=/run/x-auto-post

[Service]
Type=oneshot
User=x-post-daily
Group=x-post-daily
WorkingDirectory=/opt/x-post-automation/current
EnvironmentFile=/etc/x-auto-post.env
EnvironmentFile=/etc/x-auto-post.secrets
ExecStart=/usr/bin/python3 /opt/x-post-automation/current/scripts/x_auto_post_runner.py --mode tick
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
ReadOnlyPaths=/opt/x-post-automation/current
ReadWritePaths=/run/x-auto-post
UMask=0077
TimeoutStartSec=180s
KillMode=mixed
