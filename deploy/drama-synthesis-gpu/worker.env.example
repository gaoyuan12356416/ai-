# systemd EnvironmentFile, not a shell script. Install root-owned mode 0600 at
# /etc/drama-synthesis-gpu/worker.env. Fill secrets only on the target host.
# No CPU DB, X, TT, or YouTube credentials belong in this media-only worker.
GPU_VIDEO_WORKER_TOKEN=
GPU_VIDEO_WORKER_URL=
DRAMA_GPU_RELEASE_SHA=
DRAMA_GPU_HOST=127.0.0.1
DRAMA_GPU_PORT=8787
DRAMA_GPU_MAX_CONCURRENCY=1
DRAMA_GPU_QUEUE_LIMIT=16
DRAMA_GPU_DOWNLOAD_WORKERS=4
DRAMA_GPU_FILTER_THREADS=2
DRAMA_GPU_SUBPROCESS_TIMEOUT=43200
DRAMA_GPU_RENDER_TIMEOUT=43200
DRAMA_GPU_RENDER_STALL_SECONDS=1800

# Existing app import does not call ensure_storage; this unused DB path stays
# isolated even if a future code path accidentally tries to initialize it.
DRAMA_JOB_DB_PATH=/data/drama-synthesis-gpu/results/unused-jobs.sqlite3
DRAMA_WORK_ROOT=/data/drama-synthesis-gpu/work/jobs
DRAMA_PUBLIC_ROOT=/data/drama-synthesis-gpu/results/public
GPU_VIDEO_RESULT_ROOT=/data/drama-synthesis-gpu/results/manifests
DRAMA_PUBLIC_BASE_URL=
DRAMA_SHORT_LINK_ROOT=
DRAMA_SHORT_LINK_OWNER=
YOUTUBE_LIVE_ENABLED=0
DRAMA_YOUTUBE_UNIFIED_SYNC_ENABLED=0
TT_DRAMA_RESOURCE_SOURCE=mysql
DRAMA_SCREENSHOT_WORK_ROOT=/data/drama-synthesis-gpu/work/unused/screenshots
DRAMA_SCREENSHOT_PUBLIC_ROOT=/data/drama-synthesis-gpu/results/unused/screenshots
AD_MATERIAL_WORK_ROOT=/data/drama-synthesis-gpu/work/unused/ad-materials
AD_MATERIAL_PUBLIC_ROOT=/data/drama-synthesis-gpu/results/unused/ad-materials
DRAMA_NAVIGATION_CONFIG_PATH=/data/drama-synthesis-gpu/results/unused/navigation.json

# All binaries are service-readable, versioned, and independent of /root.
DRAMA_FFMPEG=/data/drama-synthesis-gpu/runtime/bin/ffmpeg
DRAMA_FFPROBE=/data/drama-synthesis-gpu/runtime/bin/ffprobe
DRAMA_RANDOM_OVERLAY_FFMPEG=/data/drama-synthesis-gpu/runtime/bin/ffmpeg
DRAMA_RANDOM_OVERLAY_FFPROBE=/data/drama-synthesis-gpu/runtime/bin/ffprobe
DRAMA_NVIDIA_SMI=/usr/bin/nvidia-smi
DRAMA_VIDEO_ENCODER=h264_nvenc
DRAMA_NVENC_PRESET=fast
DRAMA_NVENC_CQ=23
DRAMA_FILTER_BACKEND=cpu
DRAMA_INTRO_SECONDS=1
DRAMA_GPU_COMPOSITOR_BACKEND=opencl_fused_v2
DRAMA_GPU_COMPOSITOR_LANES=4
DRAMA_GPU_CHUNK_SECONDS=120
DRAMA_GPU_CHUNK_TIMEOUT=1800
DRAMA_GPU_OPENCL_DEVICE=0.0
DRAMA_GPU_RUNTIME_IDENTITY=ffmpeg-opencl-nvenc-runtime-v1
DRAMA_GPU_COMPOSITOR_CACHE_ROOT=/data/drama-synthesis-gpu/work/compositor-cache

# The manifest hash must match the isolated copied asset set, never an X path.
DRAMA_RANDOM_OVERLAY_ROOT=/data/drama-synthesis-gpu/assets/fb-v3-028326ab2114
DRAMA_RANDOM_OVERLAY_MANIFEST_SHA256=

# Copy mdx_extra_q.yaml and all four verified .th files into this directory.
# Passing a local repo prevents Demucs from attempting an implicit download.
DEMUCS_PYTHON=/data/drama-synthesis-gpu/runtime/current/bin/python
DEMUCS_SCRIPT=/data/drama-synthesis-gpu/current/scripts/demucs_extract_vocals.py
DEMUCS_MODEL_REPO=/data/drama-synthesis-gpu/models/demucs
DEMUCS_REQUIRE_LOCAL_MODELS=1
DEMUCS_MODEL=mdx_extra_q
DEMUCS_FALLBACK_MODEL=mdx_extra_q
DEMUCS_DEVICE=cuda
DEMUCS_SEGMENT=8
DEMUCS_FALLBACK_SEGMENT=6
DEMUCS_SHIFTS=1
DEMUCS_FALLBACK_SHIFTS=1
DEMUCS_JOBS=0
DEMUCS_CHUNK_SECONDS=90
DEMUCS_FALLBACK_CHUNK_SECONDS=45
DEMUCS_TIMEOUT=3600
GPU_VIDEO_WORKER_TIMEOUT=14400

# Pre-create these under the isolated work root, owned by drama-synthesis-gpu.
XDG_CACHE_HOME=/data/drama-synthesis-gpu/work/cache
TORCH_HOME=/data/drama-synthesis-gpu/work/cache/torch
TMPDIR=/data/drama-synthesis-gpu/work/tmp
PYTHONDONTWRITEBYTECODE=1
PYTHONNOUSERSITE=1
PYTHONUNBUFFERED=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# COS upload is required by the existing render contract. Keep values empty in
# Git; use only the user-approved isolated validation prefix until acceptance.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=
COS_PREFIX=
