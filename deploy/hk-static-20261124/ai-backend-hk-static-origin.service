[Unit]
Description=Hong Kong public static release
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/ai-hk-static/current
ExecStart=/opt/pipeline-dispatch/venvs/68407465a58d99f9dd2c9a14da000f167115f804/bin/python -B -u static_assets.py origin --release . --port 19984
Restart=on-failure
RestartSec=10
Slice=ai-backend-offload-read.slice
CPUQuota=20%
MemoryLimit=64M
Nice=15
IOSchedulingClass=idle
ProtectSystem=strict
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
