[Unit]
Description=Drama Material HK GPU Renderer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/app/drama_material_service
EnvironmentFile=/data/app/drama_material_service/.env
Environment=DRAMA_API_HOST=127.0.0.1
Environment=DRAMA_API_PORT=8788
Environment=DRAMA_JOB_DB_PATH=/data/drama-material-results/drama-jobs.sqlite3
Environment=DRAMA_WORK_ROOT=/data/drama-material-jobs
Environment=DRAMA_PUBLIC_ROOT=/data/drama-material-results/public
Environment=GPU_VIDEO_RESULT_ROOT=/data/drama-material-results/manifests
ExecStart=/usr/bin/python3 /data/app/drama_material_service/app.py
Restart=always
RestartSec=5
TimeoutStopSec=14400
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/data/drama-material-jobs /data/drama-material-results

[Install]
WantedBy=multi-user.target
