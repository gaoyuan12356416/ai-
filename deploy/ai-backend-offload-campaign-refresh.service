[Unit]
Description=Single bounded Hong Kong Campaign Copy refresh
After=network-online.target ai-backend-offload-sql-tunnel.service
Wants=network-online.target

[Service]
Type=oneshot
User=ai-read-assist
Group=ai-read-assist
Slice=ai-backend-offload-read.slice
WorkingDirectory=/data/ai-backend-offload/campaign-current
EnvironmentFile=/etc/ai-backend-offload/sql-client.env
Environment=CAMPAIGN_STATE_ROOT=/data/ai-backend-offload/campaign
ExecStart=/opt/pipeline-dispatch/venvs/68407465a58d99f9dd2c9a14da000f167115f804/bin/python -m features.gpu_offload.campaign_schedule
CPUQuota=200%
MemoryLimit=6G
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
TimeoutStartSec=infinity
TimeoutStopSec=infinity
SendSIGKILL=no
UMask=0077
