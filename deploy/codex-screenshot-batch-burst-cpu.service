[Unit]
Description=Codex Screenshot Generator Service - batch CPU burst
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/drama_material_service
Environment=PYTHONUNBUFFERED=1
Environment=CODEX_SCREENSHOT_HOST=127.0.0.1
Environment=CODEX_SCREENSHOT_PORT=8798
Environment=CODEX_SCREENSHOT_WORK_ROOT=/root/codex_screenshot_jobs_burst
Environment=CODEX_SCREENSHOT_PUBLIC_ROOT=/usr/share/nginx/html/drama-screenshot-materials
Environment=CODEX_SCREENSHOT_PUBLIC_BASE_URL=https://ai.yingliangads.com/drama-screenshot-materials
Environment=CODEX_SCREENSHOT_PROMPT_WORKSPACE=/root/codex_screenshot_worker_workspace_batch_burst
Environment=CODEX_SCREENSHOT_CACHE_ROOT=/root/codex_screenshot_cache_burst
Environment=CODEX_SCREENSHOT_MAX_CONCURRENCY=1
Environment=CODEX_SCREENSHOT_ITEM_PARALLELISM=3
Environment=CODEX_SCREENSHOT_AI_ATTEMPTS=1
Environment=CODEX_SCREENSHOT_PROMPT_VERSION=v5
Environment=CODEX_SCREENSHOT_ISOLATE_CODEX_HOME=1
Environment=CODEX_SCREENSHOT_CODEX_MODEL=gpt-5.5
Environment=CODEX_SCREENSHOT_CODEX_REASONING=low
Environment="CODEX_SCREENSHOT_CODEX_EXTRA_ARGS=--ignore-user-config --ignore-rules --ephemeral --disable plugins --disable apps --disable browser_use"
Environment=CODEX_SCREENSHOT_CODEX_TIMEOUT=2400
ExecStart=/usr/bin/python3 /root/drama_material_service/codex_screenshot_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
