# Server-only file: /etc/x-post-automation.env (root-owned mode 0600).
# Never commit real credentials or internal tokens.
X_CLIENT_ID=replace_me
X_CLIENT_SECRET=
X_INTERNAL_TOKEN=
# Dedicated least-privilege token used only by the daily runner. It must be
# different from X_INTERNAL_TOKEN and also appears in /etc/x-post-daily.env.
X_POST_DAILY_INTERNAL_TOKEN=
# Dedicated loopback bearer used only by the X auto-template control plane.
# It must differ from both X_INTERNAL_TOKEN and X_POST_DAILY_INTERNAL_TOKEN.
X_POST_AUTO_INTERNAL_TOKEN=
# Ordered, unique positive account-record IDs. Must exactly match
# /etc/x-post-daily.env. Supported batch size: 1..50.
X_POST_DAILY_ACCOUNT_IDS=101,102,103
X_PUBLIC_BASE_URL=https://ai.yingliangads.com/x-oauth
X_ADMIN_RETURN_URL=https://ai.yingliangads.com/x-accounts.html
X_LISTEN_HOST=127.0.0.1
X_LISTEN_PORT=8810
X_DATA_DIR=/var/lib/x-post-automation
X_ACCOUNTS_DB=/var/lib/x-post-automation/accounts.sqlite3
X_TOKENS_DIR=/var/lib/x-post-automation/tokens
X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access media.write
X_STATE_TTL_SECONDS=600
X_HTTP_TIMEOUT_SECONDS=30
X_POST_DB_PATH=/var/lib/x-post-automation/accounts.sqlite3
X_POST_PUBLIC_ROOT=/mnt/data-disk/x-post-automation/s2l
X_POST_SHORT_BASE_URL=https://ai.yingliangads.com/s2l
X_POST_STORAGE_MOUNT_ROOT=/mnt/data-disk
X_POST_STORAGE_ROOT=/mnt/data-disk/x-post-automation
X_POST_MEDIA_ALLOWED_HOSTS=advertising-1306474899.cos.ap-hongkong.myqcloud.com
X_POST_FFPROBE_BIN=/mnt/data-disk/x-post-automation/bin/ffprobe
X_POST_HTTP_TIMEOUT_SECONDS=30
X_POST_MAX_MEDIA_BYTES=536870912

# Global short-drama pool routing by the final prepared duration. Keep false
# for the compatibility/schema phase; Sidecar and scheduler must be enabled
# together only after additive migration and feature-off health pass.
X_POST_DRAMA_DURATION_ROUTING_ENABLED=false

# Optional one-attempt GPU repair for deferred/duration-pending drama queues.
# Disabled/missing configuration never bypasses media validation. Keep the
# repair bearer independent from OAuth/Sidecar callers; do not load the full
# daily-runner environment or expose its database credentials to this service.
# Preparation finishes before credentials are acquired; the exact source
# account is verified/refreshed again before the same downloaded file uploads.
X_POST_DEFERRED_DRAMA_REPAIR_ENABLED=false
# When enabled, use the existing controlled CPU loopback tunnel endpoint:
# http://127.0.0.1:18820/internal/x-post-media-repair
X_POST_DEFERRED_DRAMA_REPAIR_URL=
X_POST_DEFERRED_DRAMA_REPAIR_TOKEN=
# Bound: 5..3600 seconds. The scheduler's Sidecar request timeout must exceed
# this repair timeout plus download/probe/upload time before enabling it.
X_POST_DEFERRED_DRAMA_REPAIR_TIMEOUT=900
X_POST_DEFERRED_DRAMA_REPAIR_PROFILE=x-h264-nvenc-720-duration-policy-v5
