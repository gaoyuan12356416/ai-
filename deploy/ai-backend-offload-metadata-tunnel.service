[Unit]
Description=Private metadata snapshot transport
After=network-online.target
Wants=network-online.target

[Service]
Slice=ai-backend-offload-read.slice
ExecStart=/usr/bin/ssh -NT -i /etc/ai-backend-offload/tunnel_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/ai-backend-offload/known_hosts -R 127.0.0.1:19981:127.0.0.1:19980 root@43.166.187.96
CPUQuota=20%
MemoryLimit=64M
Nice=15
NoNewPrivileges=true
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
