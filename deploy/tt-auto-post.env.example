# Copy to /etc/tt-auto-post.env as root:root mode 0400.
# Non-secret safety settings only. All real-publish gates default closed.

TT_AUTO_POST_SERVICE_HOST=127.0.0.1
TT_AUTO_POST_SERVICE_PORT=18831
TT_AUTO_POST_INTERNAL_URL=http://127.0.0.1:18831
TT_AUTO_POST_DB_PATH=/mnt/data-disk/tt-auto-post-publisher/tt-auto-post.sqlite3
TT_AUTO_POST_LEGACY_DB_PATH=/mnt/data-disk/tt-post-publisher/tt-post.sqlite3
TT_AUTO_CODE_ROUTE_DB_PATH=/mnt/data-disk/tt-post-publisher/tt-post.sqlite3
TT_AUTO_POST_STATE_ROOT=/mnt/data-disk/tt-auto-post-publisher
TT_AUTO_POST_LEGACY_STATE_ROOT=/mnt/data-disk/tt-post-publisher
TT_AUTO_POST_SHORT_LINK_ROOT=/mnt/data-disk/tt-auto-post-public/s2l
TT_AUTO_CODE_ROUTE_SERVICE_HOST=127.0.0.1
TT_AUTO_CODE_ROUTE_SERVICE_PORT=18832
TT_AUTO_CODE_ROUTE_SERVICE_URL=http://127.0.0.1:18832
TT_AUTO_CODE_ROUTE_TIMEOUT_SECONDS=5

TT_POST_MYSQL_HOST=101.32.56.53
TT_POST_MYSQL_PORT=63350
TT_POST_ACCOUNT_MYSQL_DATABASE=ads_ai
TT_POST_MATERIAL_MYSQL_DATABASE=kunlunads_dev
TT_POST_GPU_URL=http://127.0.0.1:18830
TT_POST_GPU_TIMEOUT=900
TT_POST_GPU_PREPARE_TIMEOUT=9000
# Current temporary source-direct test mode. These two values are an inseparable
# pair and must match the GPU worker profile before enabling real publishing.
TT_POST_DEFAULT_SOURCE_TRIM_TAIL_SECONDS=0
TT_POST_MEDIA_PROFILE_VERSION=tt-post-source-direct-v1
# Restore the previous made-video mode as a pair when the test is over:
# TT_POST_DEFAULT_SOURCE_TRIM_TAIL_SECONDS=4.333333
# TT_POST_MEDIA_PROFILE_VERSION=tt-post-direct-outro-hevc-720x1280-v2

# Independent CPU gates. Existing TT_POST_* live gates do not enable this
# service. All three must be true before it may call GPU publish.
TT_AUTO_POST_LIVE_ENABLED=0
TT_AUTO_POST_DIRECT_AUDIT_APPROVED=0
TT_AUTO_POST_URL_PROPERTY_VERIFIED=0

TT_AUTO_POST_RUNNER_LOCK_PATH=/run/tt-auto-post/runner.lock
TT_AUTO_POST_SCHEDULER_LOCK_PATH=/run/tt-auto-post/scheduler.lock
TT_AUTO_POST_RUNNER_ID=tt-auto-post-runner-primary
TT_AUTO_POST_WORKER_COUNT=4
# One account task per worker invocation keeps the systemd oneshot deadline
# greater than the longest possible single prepare/publish request.
TT_AUTO_POST_MAX_TASKS_PER_WORKER=1
TT_AUTO_POST_SCHEDULE_GRACE_SECONDS=600
TT_AUTO_POST_METRIC_LOCK_PATH=/run/tt-auto-post/metric.lock
TT_AUTO_POST_INTERNAL_TIMEOUT=120
TT_AUTO_POST_EXECUTE_TIMEOUT=9300
# Hourly refresh keeps the default seven complete Beijing days warm. Run the
# documented one-time --lookback-days 30 command before enabling templates.
TT_AUTO_POST_METRIC_LOOKBACK_DAYS=7
