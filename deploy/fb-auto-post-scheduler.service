[Unit]
Description=Persist upcoming FB Page auto-post due slots
After=fb-auto-post-service.service
Requires=fb-auto-post-service.service

[Service]
Type=oneshot
User=fb-auto-post
Group=fb-auto-post
WorkingDirectory=/opt/fb-auto-post/current
EnvironmentFile=/etc/fb-auto-post.env
ExecStart=/usr/bin/python3 scripts/fb_auto_post_runner.py tick
TimeoutStartSec=60
UMask=0077
