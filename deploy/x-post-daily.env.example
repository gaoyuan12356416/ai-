# Server-only file: /etc/x-post-daily.env (root-owned mode 0400).
# Keep the X OAuth client secret and per-account tokens out of this file.
X_POST_DAILY_INTERNAL_URL=http://127.0.0.1:8810
X_POST_DAILY_INTERNAL_TOKEN=replace_with_dedicated_daily_bearer
X_POST_DAILY_ACCOUNT_IDS=101,102,103

# Initial production gate. This prevents Persistent=true from catching up on
# the deployment day; retain or move it forward during a controlled rollout.
X_POST_DAILY_START_DATE=2026-07-24

# Read-only MySQL endpoint and least-privilege reporting credentials.
X_POST_DAILY_MYSQL_HOST=replace_with_read_only_host
X_POST_DAILY_MYSQL_PORT=63350
X_POST_DAILY_MYSQL_USER=replace_with_read_only_user
X_POST_DAILY_MYSQL_PASSWORD=replace_with_read_only_password
X_POST_DAILY_MYSQL_DATABASE=kunlunads_dev
X_POST_DAILY_MYSQL_CONNECT_TIMEOUT=5
X_POST_DAILY_MYSQL_READ_TIMEOUT=30

X_POST_DAILY_SCAN_LIMIT=1000
X_POST_DAILY_CANDIDATE_POOL_LIMIT=50
X_POST_DAILY_MEDIA_ALLOWED_HOSTS=media.example.com
X_POST_DAILY_MAX_MEDIA_BYTES=536870912
X_POST_DAILY_MEDIA_TIMEOUT=30
X_POST_DAILY_INTERNAL_TIMEOUT=900
X_POST_DAILY_LOCK_PATH=/run/x-post-daily/runner.lock
X_POST_DAILY_WORK_DIR=/mnt/data-disk/x-post-automation/daily-work
X_POST_DAILY_MATERIAL_KEYS_PATH=/internal/posts/material-keys/query
X_POST_DAILY_STORAGE_PREFLIGHT_PATH=/internal/posts/storage/preflight
X_POST_DAILY_FAILURE_PATH=/internal/posts/runs/record-failure
X_POST_DAILY_PLAN_PATH=/internal/posts/daily-plan
X_POST_DAILY_PUBLISH_PATH_TEMPLATE=/internal/posts/queue/{queue_id}/publish
X_POST_FFPROBE_BIN=/mnt/data-disk/x-post-automation/bin/ffprobe
