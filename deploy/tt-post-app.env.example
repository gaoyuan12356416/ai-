# Copy to /etc/tt-post-app.env with root:root ownership and mode 0400.
# TT_POST_INTERNAL_TOKEN must exactly match /etc/tt-post.secrets on the CPU.

TT_POST_ADMIN_SERVICE_URL=http://127.0.0.1:18829
TT_POST_ADMIN_TIMEOUT=600
# Material preview is validation-only and must never wait for GPU preparation.
TT_POST_ADMIN_PREVIEW_TIMEOUT=60
# Public code lookup is read-only and must fail fast before the page timeout.
TT_POST_CODE_RESOLVER_TIMEOUT=3
TT_POST_INTERNAL_TOKEN=
