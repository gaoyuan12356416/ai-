# Sidecar /etc/x-post-automation.env: creation, draft/settings/pool mutations.
# Set only after the release, cookie/owner/source checks and worker validation.
X_VIDEO_PUBLISH_ENABLED=0
# /etc/x-video-publish.env: separate pool scheduler opt-in; no catch-up.
X_VIDEO_PUBLISH_POOL_SCHEDULER_ENABLED=0
# The scheduler reuses X_POST_DAILY_INTERNAL_TOKEN in /etc/x-post-daily.env.
# Do not copy X OAuth access/refresh tokens into this file.
