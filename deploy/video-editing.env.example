# CPU: inherit COS credentials and current GPU token from existing private env.
VIDEO_EDITING_ENABLED=1
VIDEO_EDITING_DISABLED_FILE=/etc/video-editing/intake.disabled
VIDEO_EDITING_DB=/mnt/data-disk/video-editing/state.sqlite3
VIDEO_EDITING_COS_PREFIX=video-editing/v1
VIDEO_EDITING_GPU_URL=http://127.0.0.1:18788
# GPU: inherit credentials, single renderer, queue capacity and existing roots.
VIDEO_EDITING_GPU_ENABLED=1
VIDEO_EDITING_SOURCE_HOSTS=img.tianmai.cn
# Touch the disabled marker on BOTH hosts to pause new editor intake.
# Existing records, GET and explicit same-ID recovery remain readable.

# CPU/GPU: bounded concurrent metadata downloads, separate from render slots.
VIDEO_EDITING_PROBE_CONCURRENCY=3

# CPU material-source upload. Use the existing shared COS credentials from .env.
# The original video-editing output remains private; only the copied object is public.
VIDEO_EDITING_MATERIAL_COS_BUCKET=advertising-1306474899
VIDEO_EDITING_MATERIAL_COS_REGION=ap-hongkong
VIDEO_EDITING_MATERIAL_COS_DOMAIN=advertising-1306474899.cos.ap-hongkong.myqcloud.com
VIDEO_EDITING_MATERIAL_COS_PREFIX=video-editing/material-source/v1
VIDEO_EDITING_MATERIAL_SOURCE_DISABLED_FILE=/etc/video-editing/material-source.disabled
