[Unit]
Description=Repair previous 30 complete FB metric days

[Service]
Type=oneshot
User=fb-auto-post
Group=fb-auto-post
WorkingDirectory=/opt/fb-auto-post/current
EnvironmentFile=/etc/fb-auto-post.env
ExecStart=/usr/bin/python3 scripts/fb_auto_post_metric_runner.py repair
RuntimeMaxSec=7200
UMask=0077
