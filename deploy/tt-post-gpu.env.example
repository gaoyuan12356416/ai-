# Non-secret GPU worker configuration.
TT_POST_GPU_ENABLED=0
TT_POST_GPU_HOST=127.0.0.1
TT_POST_GPU_PORT=8830
TT_POST_GPU_WORK_ROOT=/data/tt-post-publisher
TT_POST_GPU_FIXED_OUTRO_PATH=/data/tt-post-publisher/assets/TT-new-outro.mp4
# Used only by the legacy branded_preview mode. Formal direct_outro output is
# Logo-free and does not composite or fingerprint this asset.
TT_POST_GPU_LOGO_PATH=/data/tt-post-publisher/assets/dramawave-logo-rounded.png
# Required for direct_outro. Pin the exact approved outro; the worker refuses
# new prepares and existing prepared media if the on-disk asset drifts.
TT_POST_GPU_FIXED_OUTRO_SHA256=
TT_POST_GPU_FONT_FILE=/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf
TT_POST_GPU_ALLOWED_SOURCE_HOSTS=cdn.example.com,*.cos.example.com
TT_POST_GPU_FFMPEG_BIN=/opt/ffmpeg-nvenc/ffmpeg
TT_POST_GPU_FFPROBE_BIN=/opt/ffmpeg-nvenc/ffprobe
TT_POST_GPU_VIDEO_ENCODER=hevc_nvenc
# branded_preview keeps the Logo/tutorial outro and is never eligible for
# formal Direct Post. direct_clean only normalizes the reviewed source.
# direct_outro keeps the reviewed tutorial outro and phone transition, removes
# the Logo overlay from the source video, and uses its own formal Direct Post
# profile. source_direct performs no FFmpeg production: it validates the
# original 720x1280 H.264/AAC file and mirrors the exact bytes to the configured
# verified pull origin. The selected HEVC/H.264 profiles are
# tt-post-direct-outro-hevc-720x1280-v2 and
# tt-post-direct-outro-h264-720x1280-v2; source_direct always uses
# tt-post-source-direct-v1. All production gates still apply.
TT_POST_GPU_MEDIA_MODE=branded_preview
TT_POST_GPU_MAX_SOURCE_BYTES=2147483648
TT_POST_GPU_MAX_OUTPUT_BYTES=4294967296
TT_POST_GPU_MAX_DURATION_SECONDS=3600
# Keep 4.333333 only for the legacy branded-preview contract. Reviewed formal
# direct_clean/direct_outro deployments should set this to 0 and keep the CPU
# expectation aligned.
TT_POST_DEFAULT_SOURCE_TRIM_TAIL_SECONDS=4.333333
TT_POST_GPU_DOWNLOAD_TIMEOUT=120
TT_POST_GPU_PROBE_TIMEOUT=120
TT_POST_GPU_TRANSCODE_TIMEOUT=3600
TT_POST_GPU_COS_TIMEOUT=120
TT_POST_GPU_PREPARE_TOTAL_TIMEOUT=8700
TT_POST_GPU_CREDENTIAL_MAX_TTL_SECONDS=300

# Keep "cos" during rollout. Switch to "local" only after the dedicated HTTPS
# origin is externally reachable, its exact host/prefix is verified by TikTok,
# and Range canaries pass. Keeping the local-origin values during a rollback
# lets already-initialized local pulls finish while new prepares use COS.
TT_POST_GPU_STORAGE_BACKEND=cos

# COS remains an explicit rollback backend. Real credentials belong in
# /etc/tt-post-gpu.secrets and are required only when the selected backend is
# cos.
TT_POST_GPU_COS_BUCKET=
TT_POST_GPU_COS_REGION=
TT_POST_GPU_COS_DOMAIN=https://cdn.example.com
TT_POST_GPU_COS_PREFIX=tt-post-prepared

# GPU-local pull origin. Nginx must terminate HTTPS on the dedicated public
# domain and proxy this exact prefix to 127.0.0.1:8831 without redirects.
TT_POST_GPU_MEDIA_HOST=127.0.0.1
TT_POST_GPU_MEDIA_PORT=8831
# Target after DNS/TLS is ready:
# TT_POST_GPU_LOCAL_MEDIA_ORIGIN=https://tt-media.ai.yingliangads.com
TT_POST_GPU_LOCAL_MEDIA_ORIGIN=
TT_POST_GPU_LOCAL_MEDIA_PREFIX=tt-post-media/v1
TT_POST_GPU_LOCAL_MIN_FREE_BYTES=10737418240
# TikTok may keep pulling for up to one hour. Terminal files are removed only
# after this grace; processing and unknown-init files are never reclaimed.
TT_POST_GPU_TERMINAL_MEDIA_GRACE_SECONDS=3600

# All three compliance gates intentionally default to off.  prepare and
# creator-info remain available; publish init is denied until all are 1.
TT_POST_LIVE_ENABLED=0
TT_POST_DIRECT_AUDIT_APPROVED=0
TT_POST_URL_PROPERTY_VERIFIED=0
# Must exactly match the currently selected pull origin before "ready" can
# become true. Keep blank until the matching TikTok URL Property is verified.
TT_POST_URL_PROPERTY_VERIFIED_ORIGIN=

# /etc/tt-post-gpu.secrets (root:root 0600) must define these instead:
# TT_POST_GPU_INTERNAL_TOKEN=<dedicated random bearer, at least 32 chars>
# TT_POST_GPU_CREDENTIAL_SEAL_KEY_B64=<base64url encoded 32-byte AES key>
# TT_POST_GPU_LOCAL_URL_SIGNING_KEY_B64=<base64url encoded 32-byte HMAC key>
# TT_POST_GPU_COS_SECRET_ID=<secret>
# TT_POST_GPU_COS_SECRET_KEY=<secret>
