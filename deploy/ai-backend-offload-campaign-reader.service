[Unit]
Description=Campaign Copy immutable snapshot views
After=network.target

[Service]
Type=simple
User=ai-read-assist
Group=ai-read-assist
Slice=ai-backend-offload-read.slice
WorkingDirectory=/data/ai-backend-offload/campaign-current
EnvironmentFile=/etc/ai-backend-offload/campaign-reader.env
ExecStart=/opt/pipeline-dispatch/venvs/68407465a58d99f9dd2c9a14da000f167115f804/bin/python -m features.gpu_offload.campaign_reader
Restart=on-failure
RestartSec=10
CPUQuota=200%
MemoryLimit=1536M
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
TimeoutStopSec=infinity
SendSIGKILL=no
KillMode=process
UMask=0077

[Install]
WantedBy=multi-user.target
