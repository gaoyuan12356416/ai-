# Copy to /etc/tt-post.secrets with root:root ownership and mode 0400.
# Never commit real values. Do not reuse the CPU and GPU bearer values.

TT_POST_MYSQL_USER=
TT_POST_MYSQL_PASSWORD=
TT_POST_INTERNAL_TOKEN=
TT_POST_GPU_INTERNAL_TOKEN=

# Base64url encoding of the same random 32-byte AES-GCM key configured on the
# GPU worker as TT_POST_GPU_CREDENTIAL_SEAL_KEY_B64.
TT_POST_GPU_CREDENTIAL_SEAL_KEY_B64=
