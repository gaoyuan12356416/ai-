[Unit]
Description=Create isolated random-overlay media for FB Page tasks
After=fb-auto-post-service.service fb-auto-post-plan.service
Requires=fb-auto-post-service.service

[Service]
Type=oneshot
User=fb-auto-post
Group=fb-auto-post
WorkingDirectory=/opt/fb-auto-post/current
EnvironmentFile=/etc/fb-auto-post.env
ExecStart=/usr/bin/python3 scripts/fb_auto_post_runner.py prepare --workers 2 --max-tasks 1000 --max-seconds 1800 --lease-seconds 10200
TimeoutStartSec=12000
UMask=0077
