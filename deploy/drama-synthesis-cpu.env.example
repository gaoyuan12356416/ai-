# Install as /etc/drama-synthesis/cpu.env, root:root 0600; never source .env in a shell.
# Apply this last to the API, material job worker and new YouTube worker.
# Do not replace existing env files or move channel/OAuth queries to ads_ai.
DRAMA_DB_HOST=101.32.56.53
DRAMA_DB_PORT=63350
DRAMA_DB_NAME=kunlunads_dev
DRAMA_JOB_DB_PATH=/root/drama_material_service/data/drama_material_jobs.sqlite3
DRAMA_RANDOM_OVERLAY_MANIFEST_FILE=/mnt/data-disk/drama-synthesis-catalog/fb-v3-028326ab2114/manifest.json
DRAMA_RANDOM_OVERLAY_MANIFEST_SHA256=028326ab211418934b026c227f2e3707553cce7560551dca3c0bfddc681d566f
GPU_VIDEO_WORKER_URL=http://127.0.0.1:18788
# Populate on CPU with the existing HK media-only worker token; never commit it.
GPU_VIDEO_WORKER_TOKEN=
DRAMA_SHORT_LINK_ROOT=/mnt/data-disk/drama-youtube-short-links/s2l/youtube
DRAMA_SHORT_LINK_OWNER=drama-youtube
DRAMA_YOUTUBE_WORK_ROOT=/mnt/data-disk/drama-youtube-publish
DRAMA_YOUTUBE_SOURCE_HOSTS=advertising-1306474899.cos.ap-hongkong.myqcloud.com,ai.yingliangads.com
DRAMA_YOUTUBE_HTTP_TIMEOUT=120
DRAMA_YOUTUBE_POLL_SECONDS=10
DRAMA_YOUTUBE_UNIFIED_RPC_URL=http://127.0.0.1:18837/v1/youtube-sync
DRAMA_YOUTUBE_UNIFIED_RPC_CREDENTIAL_FILE=/etc/drama-youtube/unified-rpc-client.token
DRAMA_YOUTUBE_UNIFIED_RPC_TIMEOUT=15
# Remain off throughout the authorized internal unlisted canary.
YOUTUBE_LIVE_ENABLED=0
DRAMA_YOUTUBE_UNIFIED_SYNC_ENABLED=0
