[Unit]
Description=Verify publication scheduling support for %i
RequiresMountsFor=/mnt/data-disk
ConditionPathIsMountPoint=/mnt/data-disk

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/publish-scheduler-health/current/scripts/publish_scheduler_health.py check --lane %i --wait-seconds 25 --output /mnt/data-disk/publish-scheduler-health/latest-%i.json
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/data-disk/publish-scheduler-health
UMask=0027
