# Apply after the node's private source/COS environment files. No live secrets.
# All roots must be on the node's data disk and owned by pipeline-worker.
PIPELINE_RENDER_BACKEND=cpu
PIPELINE_EXECUTORS=x_preflight,x_random,x_repair,fb_prepare,tt_prepare,youtube_prepare,x_publish,x_share_publish,fb_publish,tt_publish,youtube_publish
PIPELINE_PREPARE_MAX=4
PIPELINE_PUBLISH_MAX=4
PIPELINE_RENDER_PROFILES=x-h264-libx264-720-duration-policy-v1,x-random-overlay-libx264-720x1280-v1,fb-post-random-overlay-libx264-720x1280-v1,tt-post-random-overlay-libx264-720x1280-v1
PIPELINE_FFMPEG_BIN=/usr/bin/ffmpeg
PIPELINE_FFPROBE_BIN=/usr/bin/ffprobe
# Copy the existing exact approved source/CDN host allowlist, including COS output.
PIPELINE_MEDIA_ALLOWED_HOSTS=

X_POST_MEDIA_REPAIR_ENABLED=1
X_POST_MEDIA_REPAIR_HOST=127.0.0.1
X_POST_MEDIA_REPAIR_WORK_ROOT=/mnt/data-disk/pipeline-dispatch/x-repair
X_POST_MEDIA_REPAIR_FFMPEG_BIN=/usr/bin/ffmpeg
X_POST_MEDIA_REPAIR_FFPROBE_BIN=/usr/bin/ffprobe
X_POST_FFPROBE_BIN=/usr/bin/ffprobe
X_POST_MEDIA_REPAIR_ALLOWED_HOSTS=
X_POST_RANDOM_TEMPLATE_ASSET_ROOT=/mnt/data-disk/pipeline-dispatch/assets/catalog
X_POST_RANDOM_TEMPLATE_MANIFEST_SHA256=
# Private source file: X_POST_MEDIA_REPAIR_TOKEN, COS_SECRET_ID, COS_SECRET_KEY,
# COS_BUCKET, COS_REGION, COS_DOMAIN. These configure local SDK calls, no GPU RPC.

FB_PAGE_GPU_HOST=127.0.0.1
FB_PAGE_GPU_PORT=8836
FB_PAGE_GPU_WORK_ROOT=/mnt/data-disk/pipeline-dispatch/fb-prepare
FB_PAGE_GPU_RANDOM_OVERLAY_ROOT=/mnt/data-disk/pipeline-dispatch/assets/catalog
FB_PAGE_GPU_RANDOM_OVERLAY_MANIFEST_SHA256=
FB_PAGE_GPU_ALLOWED_SOURCE_HOSTS=
FB_PAGE_GPU_FFMPEG_BIN=/usr/bin/ffmpeg
FB_PAGE_GPU_FFPROBE_BIN=/usr/bin/ffprobe
FB_PAGE_GPU_VIDEO_ENCODER=libx264
FB_PAGE_GPU_PROFILE=fb-post-random-overlay-libx264-720x1280-v1
FB_PAGE_GPU_COMPOSITOR_BACKEND=cpu_legacy
FB_PAGE_GPU_PREPARE_ONLY=1
FB_PAGE_GPU_MAX_JOBS=1
FB_PAGE_GPU_COS_PREFIX=fb-page-random-overlay-h264-v3
# Private source file: FB_PAGE_GPU_INTERNAL_TOKEN, FB_PAGE_GPU_COS_SECRET_ID,
# FB_PAGE_GPU_COS_SECRET_KEY, FB_PAGE_GPU_COS_BUCKET, FB_PAGE_GPU_COS_REGION,
# FB_PAGE_GPU_COS_DOMAIN. Exact same approved asset manifest as the GPU catalog.

TT_POST_GPU_ENABLED=1
TT_POST_GPU_HOST=127.0.0.1
TT_POST_GPU_WORK_ROOT=/mnt/data-disk/pipeline-dispatch/tt-prepare
TT_POST_GPU_FFMPEG_BIN=/usr/bin/ffmpeg
TT_POST_GPU_FFPROBE_BIN=/usr/bin/ffprobe
TT_POST_GPU_VIDEO_ENCODER=libx264
TT_POST_GPU_MEDIA_MODE=random_overlay
TT_POST_GPU_COMPOSITOR_BACKEND=cpu_legacy
TT_POST_DEFAULT_SOURCE_TRIM_TAIL_SECONDS=0
TT_POST_GPU_STORAGE_BACKEND=cos
TT_POST_GPU_ALLOWED_SOURCE_HOSTS=
TT_POST_GPU_RANDOM_OVERLAY_ROOT=/mnt/data-disk/pipeline-dispatch/assets/catalog
TT_POST_GPU_RANDOM_OVERLAY_MANIFEST_SHA256=
TT_POST_GPU_FIXED_OUTRO_PATH=/mnt/data-disk/pipeline-dispatch/assets/approved-outro.mp4
TT_POST_GPU_FIXED_OUTRO_SHA256=
TT_POST_GPU_LOGO_PATH=/mnt/data-disk/pipeline-dispatch/assets/dramawave-logo.png
TT_POST_GPU_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
TT_POST_GPU_COS_PREFIX=tt-post-prepared
# Private source file: TT_POST_GPU_INTERNAL_TOKEN, TT_POST_GPU_CREDENTIAL_SEAL_KEY_B64,
# TT_POST_GPU_COS_SECRET_ID, TT_POST_GPU_COS_SECRET_KEY, TT_POST_GPU_COS_BUCKET,
# TT_POST_GPU_COS_REGION, TT_POST_GPU_COS_DOMAIN, TT_POST_URL_PROPERTY_VERIFIED_ORIGIN.
# Existing central TT compliance and consent gates remain authoritative.

YOUTUBE_AUTO_CODEX_BIN=/usr/bin/codex
# Dedicated local CLI auth directory, owned0600 by pipeline-worker; no history.
CODEX_HOME=/mnt/data-disk/pipeline-dispatch/codex-auth
# Model/settings preserve the existing approved-cover worker configuration.
