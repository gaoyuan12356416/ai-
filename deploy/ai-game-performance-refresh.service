[Unit]
Description=Refresh and publish the AI game performance report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/ai-game-performance/current/ops/ai-game-performance
EnvironmentFile=-/etc/ai-game-performance.env
ExecStart=/usr/bin/flock -n -E 75 /tmp/tt_minis_multi_dim_dashboard.lock /usr/bin/python3 /opt/ai-game-performance/current/ops/ai-game-performance/ai_game_performance_dashboard.py --refresh-cache --publish
SuccessExitStatus=75
TimeoutStartSec=900
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/mnt/data-disk/ai-game-performance /usr/share/nginx/html/reports/ai-game-performance
