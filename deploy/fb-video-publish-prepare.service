[Unit]
Description=Facebook manual paired random-video preparation
After=fb-auto-post-service.service
Requires=fb-auto-post-service.service

[Service]
Type=oneshot
User=fb-auto-post
Group=fb-auto-post
WorkingDirectory=/opt/fb-auto-post/current
EnvironmentFile=/etc/fb-auto-post.env
ExecStart=/usr/bin/python3 scripts/fb_video_publish_worker.py prepare
TimeoutStartSec=12000
TimeoutStopSec=10200
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
