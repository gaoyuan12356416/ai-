[Unit]
Description=Independent COS capacity settings gateway
After=network.target

[Service]
Type=simple
User=nobody
WorkingDirectory=/opt/pipeline-capacity-gateway/current
EnvironmentFile=/etc/pipeline-monitor.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m features.pipeline_dispatch.capacity_gateway
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
