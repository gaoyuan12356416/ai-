[Unit]
Description=X channel growth metrics and profile refresh
After=network-online.target x-post-automation.service

[Service]
Type=oneshot
User=x-post-automation
Group=x-post-automation
EnvironmentFile=/etc/x-tag-publisher.env
WorkingDirectory=/opt/x-tag-publisher/current
ExecStart=/usr/bin/python3 -B -m features.x_growth_profile.collector
TimeoutStartSec=20min
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/data-disk/x-tag-publisher/growth
ReadOnlyPaths=/var/lib/x-post-automation /mnt/data-disk/x-tag-publisher/posts /mnt/data-disk/x-tag-publisher/auto
