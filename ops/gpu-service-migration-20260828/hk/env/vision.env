PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PATH=/data/ad-material/runtime/python/bin:/data/ad-material/runtime/bin:/data/ad-material/runtime/usr/bin:/usr/local/bin:/usr/bin:/bin
HOME=/data/ad-material/vision/home
XDG_CACHE_HOME=/data/ad-material/vision/cache
TMPDIR=/data/ad-material/vision/tmp
AD_MATERIAL_VISION_HOST=127.0.0.1
AD_MATERIAL_VISION_PORT=8796
AD_MATERIAL_VISION_WORK_ROOT=/data/ad-material/vision/jobs
AD_MATERIAL_VISION_CODEX_BIN=/data/ad-material/runtime/bin/codex
AD_MATERIAL_VISION_CODEX_MODEL=gpt-5.5
AD_MATERIAL_VISION_CODEX_REASONING=medium
AD_MATERIAL_VISION_CODEX_TIMEOUT=2400
AD_MATERIAL_VISION_ISOLATE_CODEX_HOME=1
AD_MATERIAL_VISION_SOURCE_CODEX_HOME=/data/ad-material/auth-source
AD_MATERIAL_VISION_MAX_CONCURRENCY=1
