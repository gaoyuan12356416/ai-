[Unit]
Description=Refresh DramaWave TikTok revenue profiles from the hourly report
After=network-online.target
RequiresMountsFor=/mnt/data-disk/tt-promotion
[Service]
Type=oneshot
WorkingDirectory=/opt/tt-promotion/current
EnvironmentFile=-/mnt/data-disk/social-tt-20261125/site.env
ExecStart=/usr/bin/python3 -B -m features.tt_promotion.profiles refresh
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/mnt/data-disk/tt-promotion/profiles
