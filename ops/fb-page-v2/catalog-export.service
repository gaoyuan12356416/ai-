[Unit]
Description=Export the verified Page and drama catalog for Hong Kong V2
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/opt/fb-page-assignment-v2/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m features.fb_page_assignment_v2.snapshot export
UMask=0077
Nice=10
