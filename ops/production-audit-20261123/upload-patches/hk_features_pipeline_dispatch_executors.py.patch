+        reconstruction=None
+        if proof==expected['sha256']:
+            reconstruction=COSArtifactStore(journal.store,'fb_prepare',request,
+                source_key=getattr(context,'job',{}).get('source_key',''),predecessor=receipt)
+            try:
+                recovered=reconstruction.recover()
+            except ExecutionError as exc:
+                if exc.code!='artifact_upload_incomplete':raise
+                return self._resume_qualified_fb(processor,request,context,reconstruction)
