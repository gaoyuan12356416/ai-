[Unit]
Description=Reconcile retired Facebook automatic template tasks
RequiresMountsFor=/mnt/data-disk

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/fb-inactive-queue/current/retire.py run --native /mnt/data-disk/fb-auto-post-publisher/fb-auto-post.sqlite3 --dispatch /mnt/data-disk/pipeline-dispatch/dispatch.sqlite3 --runtime /opt/fb-auto-post/current
UMask=0077
