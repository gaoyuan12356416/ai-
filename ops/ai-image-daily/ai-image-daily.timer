[Unit]
Description=Refresh prior-day AI image report at 09:00 Beijing, with bounded retries

[Timer]
OnCalendar=*-*-* 09:00:00 Asia/Shanghai
OnCalendar=*-*-* 09:10:00 Asia/Shanghai
OnCalendar=*-*-* 09:30:00 Asia/Shanghai
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=ai-image-daily.service

[Install]
WantedBy=timers.target
