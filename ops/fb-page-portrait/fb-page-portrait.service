[Unit]
Description=Facebook Page income portrait read service
After=network.target

[Service]
WorkingDirectory=/opt/fb-page-portraits/current
ExecStart=/usr/bin/python3 -m features.fb_page_portrait.server
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# mode=ro SQLite still needs to create WAL shared-memory bookkeeping when the
# last writer has checkpointed and removed the side files. SQL remains read-only.
ReadWritePaths=/mnt/data-disk/root-storage-20260915/rootfs/root/drama_material_service/data /mnt/data-disk/fb-auto-post-publisher
PrivateTmp=true
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
