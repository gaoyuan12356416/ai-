[Unit]
Description=Dramawave D7/D10 attribution comparison dashboard
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/data-disk

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/dramawave-attribution-comparison/current
EnvironmentFile=/mnt/data-disk/dramawave-attribution-comparison/dashboard.env
Environment=PYTHONUNBUFFERED=1
Environment=DRAMAWAVE_ATTRIBUTION_HOST=127.0.0.1
Environment=DRAMAWAVE_ATTRIBUTION_PORT=8832
ExecStart=/opt/dramawave-attribution-comparison/venv/bin/python /opt/dramawave-attribution-comparison/current/service.py
ExecStartPost=-/opt/dramawave-attribution-comparison/venv/bin/python /opt/dramawave-attribution-comparison/current/warm_cache.py --attempts 10 --retry-delay 1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/dramawave-attribution-comparison/current
ReadWritePaths=/mnt/data-disk/dramawave-attribution-comparison/cache

[Install]
WantedBy=multi-user.target
