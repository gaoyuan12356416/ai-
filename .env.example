AD_CONTROL_ACTION_LOG_IO_TIMEOUT=5
AD_CONTROL_ACTION_LOG_LOCAL_OFFSET_HOURS=8
AD_CONTROL_RUNNER_MAX_CONTINUATIONS=24

# FB Campaign copy is fail-closed. Keep both switches disabled through shadow rollout.
AD_CONTROL_COPY_ENABLED=0
AD_CONTROL_AD_COPY_ENABLED=0
AD_CONTROL_COPY_DAILY_HARD_LIMIT=50
AD_CONTROL_COPY_USER_DAILY_LIMIT=10
