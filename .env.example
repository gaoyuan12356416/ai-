TT_DRAMA_RESOLVER_COVER_HOSTS=static-v1.mydramawave.com,static-v2.mydramawave.com,static.mydramawave.com,cdn.usrgrow.com,ads-cdn.yingliang.tech

# AI automated rule control execution and durable audit log.
AD_CONTROL_MAX_LIVE_EXECUTE=200
AD_CONTROL_MAX_LIVE_EXECUTE_PER_ACCOUNT=20
AD_CONTROL_LIVE_MAX_WORKERS=4
AD_CONTROL_LIVE_EXECUTE_MAX_WORKERS=4
AD_CONTROL_ACTION_LOG_DB_NAME=ads_ai
AD_CONTROL_ACTION_LOG_TABLE=ad_control_action_log
AD_CONTROL_ACTION_LOG_MYSQL_HOST=101.32.56.53
AD_CONTROL_ACTION_LOG_MYSQL_PORT=63353
AD_CONTROL_ACTION_LOG_MYSQL_USER=
AD_CONTROL_ACTION_LOG_MYSQL_PASSWORD=
