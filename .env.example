# Copy to .env on the target server and fill real values. Do not commit .env.
HOST=0.0.0.0
PORT=8787
DRAMA_WORK_ROOT=/root/drama_material_jobs
DRAMA_PUBLIC_ROOT=/usr/share/nginx/html/drama-materials
DRAMA_INTRO_SECONDS=1

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=
COS_PREFIX=drama-materials

GPU_VIDEO_WORKER_TOKEN=
GPU_VIDEO_WORKER_URL=
