# Copy to .env on the target server and fill real values. Do not commit .env.
HOST=0.0.0.0
PORT=8787
DRAMA_WORK_ROOT=/root/drama_material_jobs
DRAMA_PUBLIC_ROOT=/usr/share/nginx/html/drama-materials
DRAMA_INTRO_SECONDS=1

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=
COS_PREFIX=drama-materials

GPU_VIDEO_WORKER_TOKEN=
GPU_VIDEO_WORKER_URL=
GPU_VIDEO_WORKER_TIMEOUT=1800
GPU_VIDEO_RESULT_ROOT=/root/drama_material_job_results
DRAMA_PUBLIC_ARTIFACT_CHECK_TIMEOUT=20

# Drama synthesis upgrade. CPU: use http://127.0.0.1:18788 only after the HK
# reverse tunnel is verified. Keep the legacy 18787 path intact during canary.
# CPU: install only the original manifest bytes at an absolute local path;
# catalog queries never contact a GPU. Do not copy the media bundle to CPU.
DRAMA_RANDOM_OVERLAY_MANIFEST_FILE=
# DRAMA_RANDOM_OVERLAY_MANIFEST_FILE=/mnt/data-disk/drama-synthesis-catalog/fb-v3-028326ab2114/manifest.json
# HK: keep this CPU-only setting empty. The renderer uses the verified asset
# root below and independently checks every file; light is not a recipe layer.
DRAMA_RANDOM_OVERLAY_ROOT=
DRAMA_RANDOM_OVERLAY_MANIFEST_SHA256=028326ab211418934b026c227f2e3707553cce7560551dca3c0bfddc681d566f
DRAMA_RANDOM_OVERLAY_FFMPEG=/usr/bin/ffmpeg
DRAMA_RANDOM_OVERLAY_FFPROBE=/usr/bin/ffprobe

# Filesystem adapter for the dedicated gy.g2flow.com /s2l/youtube namespace.
# Configure both values or neither. Production pair is the path/owner below;
# the directory must already be owner 0750 with the reviewed nginx read ACL.
DRAMA_SHORT_LINK_ROOT=
DRAMA_SHORT_LINK_OWNER=
# DRAMA_SHORT_LINK_ROOT=/mnt/data-disk/drama-youtube-short-links/s2l/youtube
# DRAMA_SHORT_LINK_OWNER=drama-youtube

# Async YouTube worker. Hosts must be the exact HTTPS origins used by completed
# drama video URLs. Credentials remain in the existing server-side MySQL rows.
DRAMA_YOUTUBE_WORK_ROOT=/mnt/data-disk/drama-youtube-publish
DRAMA_YOUTUBE_SOURCE_HOSTS=advertising-1306474899.cos.ap-hongkong.myqcloud.com,ai.yingliangads.com
DRAMA_YOUTUBE_HTTP_TIMEOUT=120
DRAMA_YOUTUBE_MEDIA_EXECUTOR_URL=
DRAMA_YOUTUBE_MEDIA_EXECUTOR_TIMEOUT=7200
DRAMA_YOUTUBE_MEDIA_ROOT=/data/drama-synthesis-gpu/work/youtube-publish
DRAMA_YOUTUBE_MEDIA_HTTP_TIMEOUT=7200
DRAMA_YOUTUBE_POLL_SECONDS=10
YOUTUBE_LIVE_ENABLED=0

# CPU-owned dedicated ads_ai ledger RPC. It never writes the original
# kunlunads_dev YouTube tables; those remain read-only channel/auth sources.
# The credential file is server-only,
# absolute, non-symlinked and mode 0600; never put its value in this env file.
DRAMA_YOUTUBE_UNIFIED_SYNC_ENABLED=0
DRAMA_YOUTUBE_UNIFIED_RPC_URL=
DRAMA_YOUTUBE_UNIFIED_RPC_CREDENTIAL_FILE=
# Production pair: http://127.0.0.1:18837/v1/youtube-sync and
# /etc/drama-youtube/unified-rpc-client.token (root:root 0600). Configure both
# or neither. The server reads a second same-value copy owned by drama-youtube.
DRAMA_YOUTUBE_UNIFIED_RPC_TIMEOUT=15
CODEX_COVER_STRATEGY=codex_imagegen

# Set DRAMA_JOB_USE_WORKER=1 on the API service only after enabling
# drama-material-job-worker.service. Leave legacy recovery off unless an
# old in-process job has already lost its API thread.
DRAMA_JOB_USE_WORKER=0
DRAMA_JOB_WORKER_POLL_SECONDS=10
DRAMA_JOB_WORKER_HEARTBEAT_SECONDS=15
DRAMA_JOB_WORKER_STALE_SECONDS=900
DRAMA_JOB_WORKER_RECOVER_LEGACY=0

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_SCOPE=contact:user.id:readonly contact:user.email:readonly

