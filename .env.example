# Copy to .env on the target server and fill real values. Do not commit .env.
HOST=0.0.0.0
PORT=8787
DRAMA_WORK_ROOT=/root/drama_material_jobs
DRAMA_PUBLIC_ROOT=/usr/share/nginx/html/drama-materials
DRAMA_INTRO_SECONDS=1

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=
COS_PREFIX=drama-materials

GPU_VIDEO_WORKER_TOKEN=
GPU_VIDEO_WORKER_URL=
GPU_VIDEO_WORKER_TIMEOUT=1800
GPU_VIDEO_RESULT_ROOT=/root/drama_material_job_results
DRAMA_PUBLIC_ARTIFACT_CHECK_TIMEOUT=20
CODEX_COVER_STRATEGY=codex_imagegen

# Set DRAMA_JOB_USE_WORKER=1 on the API service only after enabling
# drama-material-job-worker.service. Leave legacy recovery off unless an
# old in-process job has already lost its API thread.
DRAMA_JOB_USE_WORKER=0
DRAMA_JOB_WORKER_POLL_SECONDS=10
DRAMA_JOB_WORKER_HEARTBEAT_SECONDS=15
DRAMA_JOB_WORKER_STALE_SECONDS=900
DRAMA_JOB_WORKER_RECOVER_LEGACY=0

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_SCOPE=contact:user.id:readonly contact:user.email:readonly

AI_SOURCE_CALLBACK_URL=
AI_SOURCE_CALLBACK_TOKEN=

AD_MATERIAL_SOURCE_API_URL=https://aa.yingliangads.com/api/material/source
AD_MATERIAL_SOURCE_API_TOKEN=
AD_MATERIAL_SOURCE_API_TIMEOUT=30
AD_MATERIAL_REQUIREMENT_COMMAND=
AD_MATERIAL_GENERATION_COMMAND=/usr/bin/python3 /root/drama_material_service/scripts/ad_material_generation_runner.py
AD_MATERIAL_COMMAND_TIMEOUT=2400
AD_MATERIAL_GENERATION_SERVICE_URL=http://127.0.0.1:18797/api/ad-material-generation/generate
AD_MATERIAL_GENERATION_SERVICE_TIMEOUT=2400
AD_MATERIAL_VISION_PROVIDER=codex
AD_MATERIAL_CODEX_VISION_URL=
AD_MATERIAL_VISION_TIMEOUT=360
AD_MATERIAL_VISION_BATCH_SIZE=2
AD_MATERIAL_CODEX_BIN=/usr/bin/codex
AD_MATERIAL_CODEX_MODEL=gpt-5.5
AD_MATERIAL_CODEX_REASONING=medium
AD_MATERIAL_CODEX_TIMEOUT=2400
AD_MATERIAL_CODEX_ISOLATE_HOME=1
AD_MATERIAL_CODEX_SOURCE_HOME=/root/.codex
AD_MATERIAL_WORK_ROOT=/root/ad_material_tasks
AD_MATERIAL_PUBLIC_ROOT=/usr/share/nginx/html/ad-materials
AD_MATERIAL_PUBLIC_BASE_URL=https://ai.yingliangads.com/ad-materials
AD_MATERIAL_ADMIN_URL=https://ai.yingliangads.com/#adMaterials
AD_MATERIAL_FINAL_USER_ID=248
AD_MATERIAL_COMPETITOR_ALERT_RECEIVE_ID_TYPE=
AD_MATERIAL_COMPETITOR_ALERT_RECEIVE_ID=
AD_MATERIAL_COMPETITOR_ALERT_OPEN_IDS=

CODEX_SCREENSHOT_BATCH_ENABLED=0
CODEX_SCREENSHOT_PROMPT_VERSION=v2
SCREENSHOT_ITEM_RETRY_ATTEMPTS=3

ADMIN_MAPPING_MYSQL_HOST=
ADMIN_MAPPING_MYSQL_PORT=
ADMIN_MAPPING_MYSQL_USER=
ADMIN_MAPPING_MYSQL_PASSWORD=
ADMIN_MAPPING_MYSQL_DATABASE=
