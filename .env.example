# Copy to .env on the target server and fill real values. Do not commit .env.
HOST=0.0.0.0
PORT=8787
DRAMA_WORK_ROOT=/root/drama_material_jobs
DRAMA_PUBLIC_ROOT=/usr/share/nginx/html/drama-materials
DRAMA_INTRO_SECONDS=1

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=
COS_PREFIX=drama-materials

GPU_VIDEO_WORKER_TOKEN=
GPU_VIDEO_WORKER_URL=
GPU_VIDEO_WORKER_TIMEOUT=1800
GPU_VIDEO_RESULT_ROOT=/root/drama_material_job_results
DRAMA_PUBLIC_ARTIFACT_CHECK_TIMEOUT=20
CODEX_COVER_STRATEGY=codex_imagegen

# Set DRAMA_JOB_USE_WORKER=1 on the API service only after enabling
# drama-material-job-worker.service. Leave legacy recovery off unless an
# old in-process job has already lost its API thread.
DRAMA_JOB_USE_WORKER=0
DRAMA_JOB_WORKER_POLL_SECONDS=10
DRAMA_JOB_WORKER_HEARTBEAT_SECONDS=15
DRAMA_JOB_WORKER_STALE_SECONDS=900
DRAMA_JOB_WORKER_RECOVER_LEGACY=0

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_SCOPE=contact:user.id:readonly contact:user.email:readonly

AI_SOURCE_CALLBACK_URL=
AI_SOURCE_CALLBACK_TOKEN=

AD_MATERIAL_SOURCE_API_URL=https://aa.yingliangads.com/api/material/source
AD_MATERIAL_SOURCE_API_TOKEN=
AD_MATERIAL_SOURCE_API_TIMEOUT=30
AD_MATERIAL_REQUIREMENT_COMMAND=
AD_MATERIAL_GENERATION_COMMAND=/usr/bin/python3 /root/drama_material_service/scripts/ad_material_generation_runner.py
AD_MATERIAL_COMMAND_TIMEOUT=2400
AD_MATERIAL_GENERATION_SERVICE_URL=http://127.0.0.1:18797/api/ad-material-generation/generate
AD_MATERIAL_GENERATION_SERVICE_TIMEOUT=2400
AD_MATERIAL_VISION_PROVIDER=codex
AD_MATERIAL_CODEX_VISION_URL=
AD_MATERIAL_VISION_TIMEOUT=360
AD_MATERIAL_VISION_BATCH_SIZE=2
AD_MATERIAL_CODEX_BIN=/usr/bin/codex
AD_MATERIAL_CODEX_MODEL=gpt-5.5
AD_MATERIAL_CODEX_REASONING=medium
AD_MATERIAL_CODEX_TIMEOUT=2400
AD_MATERIAL_CODEX_ISOLATE_HOME=1
AD_MATERIAL_CODEX_SOURCE_HOME=/root/.codex
AD_MATERIAL_WORK_ROOT=/root/ad_material_tasks
AD_MATERIAL_PUBLIC_ROOT=/usr/share/nginx/html/ad-materials
AD_MATERIAL_PUBLIC_BASE_URL=https://ai.yingliangads.com/ad-materials
AD_MATERIAL_ADMIN_URL=https://ai.yingliangads.com/#adMaterials
AD_MATERIAL_FINAL_USER_ID=248
AD_MATERIAL_COMPETITOR_ALERT_RECEIVE_ID_TYPE=
AD_MATERIAL_COMPETITOR_ALERT_RECEIVE_ID=
AD_MATERIAL_COMPETITOR_ALERT_OPEN_IDS=

# Meta/Facebook playable preview packaging API. Production should use enforce
# with a strong server-only token. FB_PLAYABLE_API_TOKEN is a legacy env alias.
PLAYABLE_PREVIEW_AUTH_MODE=enforce
PLAYABLE_PREVIEW_API_TOKEN=
FB_PLAYABLE_API_TOKEN=
PLAYABLE_PREVIEW_MAX_UPLOAD_BYTES=83886080
PLAYABLE_PREVIEW_MAX_EXTRACTED_BYTES=83886080
PLAYABLE_PREVIEW_MAX_EXTRACTED_FILES=4096
PLAYABLE_PREVIEW_REMOTE_CONNECT_TIMEOUT=5
PLAYABLE_PREVIEW_REMOTE_READ_TIMEOUT=20
PLAYABLE_PREVIEW_REMOTE_MAX_REDIRECTS=3
PLAYABLE_PREVIEW_MAX_CONCURRENCY=1
PLAYABLE_PREVIEW_MAX_ASSET_BYTES=4800000
PLAYABLE_PREVIEW_MAX_ZIP_BYTES=4800000
PLAYABLE_PREVIEW_TRIAL_SECONDS=20

VOICEOVER_KOL_TASK_API_URL=https://ads-admin.static.kunlun.com/api/ai/kol-task
VOICEOVER_KOL_TASK_API_TOKEN=
VOICEOVER_KOL_TASK_API_TIMEOUT=30
VOICEOVER_DESIGNER_ROLE_APP_ID=78
VOICEOVER_DEFAULT_ROAS_THRESHOLD=45
VOICEOVER_DEFAULT_MIN_CANDIDATES=15
VOICEOVER_DEFAULT_APP_ID=
VOICEOVER_CUSTOM_SOURCE_DATA_SOURCE=6
VOICEOVER_FILTER_SOURCE_SCAN_LIMIT=1500
VOICEOVER_FILTER_SOURCE_SCAN_MAX=3000
VOICEOVER_FILTER_LEGACY_FALLBACK=0
VOICEOVER_CREATE_MAX_WORKERS=5

# X OAuth credentials and user tokens remain in the loopback sidecar.
# Use the same server-only internal token in both service environment files.
X_POST_AUTOMATION_INTERNAL_URL=http://127.0.0.1:8810
X_POST_AUTOMATION_INTERNAL_TOKEN=
X_POST_AUTOMATION_INTERNAL_TIMEOUT=30

# Daily Dramawave X publishing runner. Production secrets belong only in
# /etc/x-post-daily.env (root-owned 0400); no OAuth client secret or account token is used.
X_POST_DAILY_INTERNAL_URL=http://127.0.0.1:8810
X_POST_DAILY_INTERNAL_TOKEN=
X_POST_DAILY_ACCOUNT_IDS=
X_POST_DAILY_START_DATE=
X_POST_DAILY_MYSQL_HOST=
X_POST_DAILY_MYSQL_PORT=63350
X_POST_DAILY_MYSQL_USER=
X_POST_DAILY_MYSQL_PASSWORD=
X_POST_DAILY_MYSQL_DATABASE=kunlunads_dev
X_POST_DAILY_MYSQL_CONNECT_TIMEOUT=5
X_POST_DAILY_MYSQL_READ_TIMEOUT=30
X_POST_DAILY_SCAN_LIMIT=1000
X_POST_DAILY_CANDIDATE_POOL_LIMIT=50
X_POST_DAILY_MEDIA_ALLOWED_HOSTS=
X_POST_DAILY_MAX_MEDIA_BYTES=536870912
X_POST_DAILY_MEDIA_TIMEOUT=30
X_POST_DAILY_INTERNAL_TIMEOUT=900
X_POST_DAILY_LOCK_PATH=/run/x-post-daily/runner.lock
X_POST_DAILY_WORK_DIR=/mnt/data-disk/x-post-automation/daily-work
X_POST_DAILY_POOL_AVAILABLE_PATH=/internal/posts/material-pool/available
X_POST_DAILY_POOL_CHECK_PATH=/internal/posts/material-pool/check
X_POST_DAILY_STORAGE_PREFLIGHT_PATH=/internal/posts/storage/preflight
X_POST_DAILY_FAILURE_PATH=/internal/posts/runs/record-failure
X_POST_DAILY_PLAN_PATH=/internal/posts/daily-plan
X_POST_DAILY_PUBLISH_PATH_TEMPLATE=/internal/posts/queue/{queue_id}/publish

CODEX_SCREENSHOT_SERVICE_URL=http://127.0.0.1:18795/api/codex-screenshot/generate
CODEX_SCREENSHOT_SERVICE_URL_SQUARE_1X1=http://127.0.0.1:18795/api/codex-screenshot/generate
