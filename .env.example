CODEX_SCREENSHOT_SERVICE_POOL=http://127.0.0.1:18798/api/codex-screenshot/generate,http://127.0.0.1:8795/api/codex-screenshot/generate,http://127.0.0.1:8798/api/codex-screenshot/generate,http://127.0.0.1:18795/api/codex-screenshot/generate
